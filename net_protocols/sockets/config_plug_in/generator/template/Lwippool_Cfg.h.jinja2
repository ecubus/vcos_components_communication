/*!*********************************************************************************************************************
 * @file        Lwippool_Cfg.h
 * @brief       TcpIp配置头文件
 * @details     主要包含和内存池相关的配置信息
 * @date        {{get_generation_time_temp()}}
 **********************************************************************************************************************/
{%- set TcpIpConfig = get_TcpIpConfig() %}
#if MEM_USE_POOLS
LWIP_MALLOC_MEMPOOL_START
{%- for buffer_memory in TcpIpConfig.TcpIpBufferMemoryConfig %}
{{"LWIP_MALLOC_MEMPOOL(%s, %s)" | format(buffer_memory.TcpIpBufferMemoryNum.Value, buffer_memory.TcpIpBufferMemoryLen.Value)}}
{%- endfor %}
LWIP_MALLOC_MEMPOOL_END
#endif /* MEM_USE_POOLS */