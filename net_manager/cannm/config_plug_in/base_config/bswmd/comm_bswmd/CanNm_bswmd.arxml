                          <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0.06</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d11eee3e-14a4-486a-965a-7a2c2f9e5793">
                          <SHORT-NAME>CanNmRemoteSleepIndTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout for Remote Sleep Indication.</L-2>
                            <L-2 L="ZH">概述：CanNmRemoteSleepIndTime定义了在CAN网络管理中，从接收到最后一个NM消息到认为网络节点处于远程睡眠状态所需的时间。</L-2>
                            <L-2 L="ZH">注意：该时间参数应根据网络的具体需求和节点的响应特性来配置；过短的时间可能导致误判，过长的时间可能延迟睡眠状态的识别；确保该配置与网络中其他节点的远程睡眠时间设置保持一致。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">It defines the time in seconds how long it shall take to recognize that all other nodes are ready to sleep.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00023</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>0.5</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:fcceb68d-d4a5-4768-933e-9f44201e799d">
                          <SHORT-NAME>CanNmRepeatMessageTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout for Repeat Message State.</L-2>
                            <L-2 L="ZH">概述：CanNmRepeatMessageTime配置项定义了在CAN网络管理中，节点处于Repeat Message状态时发送重复消息的时间间隔。</L-2>
                            <L-2 L="ZH">注意：该时间间隔必须根据网络的具体需求和性能进行配置，以确保网络的稳定性和通信效率；配置值应遵循AUTOSAR CP 4.4标准中对时间参数的规定，确保与其他节点的兼容性；过短的重复消息时间可能导致网络拥塞，过长则可能影响到网络管理的及时性。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">It defines the time in seconds how long the NM shall stay in the Repeat Message State.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00022</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1.5</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:d87091a6-9fbe-4875-85c4-d8eac6bf974d">
                          <SHORT-NAME>CanNmTimeoutTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Network Timeout for NM PDUs.</L-2>
                            <L-2 L="ZH">概述：CanNmTimeoutTime是用于定义网络管理通信超时时间的配置项，它指定了CAN网络管理协议中等待网络管理消息的最大时间。</L-2>
                            <L-2 L="ZH">注意：该值必须根据网络的具体需求和性能来配置，以确保网络稳定性；超时时间设置过短可能导致误判网络故障，过长则可能延迟故障检测；应与其他网络参与者和诊断需求保持一致。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">It denotes the time in seconds how long the NM shall stay in the Ready Sleep State before
                                                transition into the Prepare Bus-Sleep Mode is initiated.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00020</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>2</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.002</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:527bf265-b1fb-41ac-8c73-7752563cbf22">
                          <SHORT-NAME>CanNmWaitBusSleepTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout for bus calm down phase.</L-2>
                            <L-2 L="ZH">概述：CanNmWaitBusSleepTime是一个配置参数，用于定义网络管理在进入总线睡眠状态之前等待的时间，这个时间是在最后一条NM消息发送后开始计算的。</L-2>
                            <L-2 L="ZH">注意：该参数的值需要根据具体的网络需求和ECU的性能来设定；过短的等待时间可能导致网络管理过早进入睡眠状态，而过长的等待时间可能会导致不必要的电源消耗；在配置此参数时，应确保它与网络上其他节点的相应参数相协调，以避免网络同步问题。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">It denotes the time in seconds how long the NM shall stay in the Prepare Bus-Sleep Mode before transition into Bus-Sleep Mode shall take place.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00021</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>5</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2e5a9851-b764-44d9-8bc6-360bd5253f4f">
                          <SHORT-NAME>CanNmCarWakeUpBitPosition</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the Bit position of the CWU within the NM PDU.</L-2>
                            <L-2 L="ZH">概述：CanNmCarWakeUpBitPosition配置项用于定义在CAN网络管理消息中，用于唤醒车辆的特定位的位置。</L-2>
                            <L-2 L="ZH">注意：该配置项的值必须在CAN消息的有效数据长度范围内；确保不与其他网络管理或诊断功能使用的位冲突；在配置时应考虑网络上所有节点的唤醒逻辑一致性。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00075</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
