                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c7e748c7-9dca-45e2-b11a-67d270c02581">
                                  <SHORT-NAME>CanIfHrhRangeRxPduLowerCanId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Lower CAN Identifier of a receive CAN L-PDU for identifier range definition, in which all CAN Ids shall pass the software filtering.</L-2>
                                    <L-2 L="ZH">概述：CanIfHrhRangeRxPduLowerCanId用于定义接收消息标识符（CAN ID）的下限，这是在配置接收硬件消息处理器（HRH）时用于过滤接收到的PDU（协议数据单元）的范围的起始值。</L-2>
                                    <L-2 L="ZH">注意：确保CanIfHrhRangeRxPduLowerCanId的值不超过CAN标准定义的最大值；在配置ID范围过滤时，该值应小于或等于对应的CanIfHrhRangeRxPduUpperCanId；在使用扩展CAN ID时，需注意ID的格式和长度。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanIf_00629</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
