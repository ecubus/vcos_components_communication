                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:9eafb305-92b9-44bb-aa1b-5baa6e583e9c">
                      <SHORT-NAME>EthIfEnableWEthApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables / Disables API's for WEth / WEthTrcv</L-2>
                        <L-2 L="ZH">概述：EthIfEnableWEthApi 配置项用于启用或禁用无线以太网接口。</L-2>
                        <L-2 L="ZH">注意：在使用此配置项时，必须确保硬件和底层驱动支持无线功能；此配置项在AUTOSAR CP 4.4中应正确与底层网络管理模块集成；不当的使用可能导致系统行为不符合预期。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
