                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f26c229b-22a1-470c-964c-ff2dfcfead83">
                      <SHORT-NAME>EthIfVerifyConfigApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables /disables EthIf_VerifyConfig API.</L-2>
                        <L-2 L="ZH">概述：EthIfVerifyConfigApi 是一个配置项，用于启用或禁用以太网接口模块（EthIf）中的配置验证API，该API用于在运行时检查PDU头部的配置参数是否与预期设置匹配。</L-2>
                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，配置验证API通常用于开发和测试阶段，以确保配置的正确性；在生产代码中，可能会因性能考虑而禁用此API；如果启用，需确保对性能影响有足够的理解和评估。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00063</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
