                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b85f0089-8105-d502-bf69-caa01c74d644">
                                      <SHORT-NAME>OPAQUE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:ecf98909-3c1d-91ca-3903-106b9cedcad2">
                                  <SHORT-NAME>ComTransferProperty</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines if a write access to this signal can trigger the transmission of the corresponding I-PDU. If the I-PDU is triggered, depends also on the transmission mode of the corresponding I-PDU.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00232</RELATED-TRACE-ITEM-REF>
