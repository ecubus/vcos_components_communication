                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00094</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <CHOICES>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:59826198-3a1a-4238-84dc-c849ebdeec2b">
                              <SHORT-NAME>TcpIpIpV4Ctrl</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies an Internet Protocol version 4 (IPv4) instance.</L-2>
                                <L-2 L="ZH">概述：TcpIpIpV4Ctrl配置项用于定义IPv4控制器的属性，包括地址配置方式、静态IP地址设置、子网掩码等，以实现网络层的IP配置管理。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保选择正确的地址配置方式（如静态或DHCP）以满足网络需求；静态IP地址配置时，需正确设置IP地址和子网掩码以避免网络冲突；IPv4配置应与网络硬件和其他网络参与者兼容。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00166</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <REFERENCES>
                                <ECUC-REFERENCE-DEF UUID="ECUC:a1218a26-276b-4b43-8579-b35f7b08fcf8">
                                  <SHORT-NAME>TcpIpArpConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to ARP configuration for this IPv4 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpConfigRef 是一个配置参考，它指向网络堆栈中的ARP（地址解析协议）配置，用于将网络层的IP地址解析为链路层的MAC地址。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpArpConfigRef时，需要确保它正确地指向了有效的ARP配置集；ARP配置集中应包含所需的所有参数，如ARP表大小、ARP请求重试次数等；在多网卡系统中，每个网络接口可能需要不同的ARP配置，因此要注意正确分配和引用。</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv4 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00097</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV4Config/TcpIpArpConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF UUID="ECUC:53cc2a36-0bc6-4dd4-a244-86b8e0815072">
                                  <SHORT-NAME>TcpIpAutoIpConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to AutoIp configuration for this IPv4 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpAutoIpConfigRef 是一个配置参考，用于将 TCP/IP 堆栈的自动IP配置与相应的自动IP配置参数关联起来，以便于在没有DHCP服务器的情况下自动分配IP地址。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpAutoIpConfigRef时，需要确保引用的自动IP配置参数是有效的并且与网络接口正确关联；此外，自动IP仅适用于IPv4地址配置；在使用自动IP功能时，还应注意网络中的地址冲突问题。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv4 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00098</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV4Config/TcpIpAutoIpConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF UUID="ECUC:ee170912-f9aa-484e-9ea1-438dfd487dc8">
                                  <SHORT-NAME>TcpIpDhcpConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to DHCP configuration for this IPv4 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpConfigRef是一个配置项，用于引用TCP/IP协议栈中DHCP（动态主机配置协议）的配置参数，使网络接口能够自动获取IP地址和其他网络设置。</L-2>
                                    <L-2 L="ZH">注意：在使用动态IP地址分配时，确保网络环境支持DHCP服务；该配置项对于实现网络通信的自动化配置至关重要，需正确配置以避免网络连接问题；在AUTOSAR CP 4.4中，确保引用的DHCP配置与实际网络需求相匹配，避免配置错误导致的网络服务不可用。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv4 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00100</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV4Config/TcpIpDhcpConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF UUID="ECUC:c232099b-2f4c-4d12-af31-7f76705104f6">
                                  <SHORT-NAME>TcpIpFragmentationConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to Fragmentation configuration for this IPv4 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpFragmentationConfigRef是一个配置参考，用于指定TCP/IP协议栈中IP分片的配置参数，包括启用或禁用IP分片以及分片的大小等。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保引用的分片配置与网络接口的实际需求相匹配；过大或过小的分片大小可能影响网络性能；分片功能的启用需要考虑目标网络环境的兼容性。</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv4 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00099</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV4Config/TcpIpIpFragmentationConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:5ff23d35-641b-4cf5-bd60-a8e99c885a55">
                                  <SHORT-NAME>TcpIpIpV4MtuConfig</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container specifies the Maximum Transmission Unit parameters for this IPv4 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV4MtuConfig 是一个配置参数，用于定义TCP/IP协议栈中IPv4的最大传输单元（MTU），即可以通过网络接口发送的最大数据包大小。</L-2>
                                    <L-2 L="ZH">注意：MTU值应小于或等于网络接口硬件能够支持的最大值，以避免数据包在传输过程中的分片；过大的MTU值可能导致网络效率降低，过小的MTU值可能增加网络的开销；在配置MTU时，还需考虑网络中其他设备的MTU设置，以确保网络互操作性。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00209</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:082d1202-dae1-4b92-a4f5-c9ad2d74d6ff">
                                      <SHORT-NAME>TcpIpIpV4PathMtuEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the IPv4 processes incoming ICMPv4 &quot;Packet Too Big&quot; messages and stores a MTU value for each destination address.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIpV4PathMtuEnabled 配置项用于启用或禁用IPv4路径最大传输单元（Path MTU）发现机制，该机制允许TCP/IP协议栈动态确定网络路径上允许的最大数据包大小，以避免分片并提高效率。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保网络栈配置与硬件和网络环境兼容；如果启用该功能，需要考虑对网络性能的影响，因为路径MTU发现可能增加网络延迟；在某些网络环境中，如存在防火墙或路由器不传递ICMP不能到达消息时，可能需要禁用该功能以避免连接问题。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00211</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:908c40aa-9d8f-4fa0-b90b-48acdd7deebc">
                                      <SHORT-NAME>TcpIpIpV4PathMtuTimeout</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If this value is &gt;0 the IpV4 will reset the MTU value stored for each destination after n seconds.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIpV4PathMtuTimeout配置项用于定义IPv4路径最大传输单元（Path MTU）发现过程中，等待路径MTU增加确认的超时时间。</L-2>
                                        <L-2 L="ZH">注意：该值应根据网络环境和应用需求谨慎设置，以避免因超时设置不当导致的数据传输效率低下或通信中断；在AUTOSAR CP 4.4标准中，确保该配置项的值符合网络协议栈的性能要求；不同网络配置和应用场景可能需要不同的超时设置。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">see [RFC1191 6.3. Purging stale PMTU information]
                                                                        Default: 600 seconds (10 minutes)</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00210</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>600</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">86400</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">1</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6905fd16-99e7-47c7-b2f5-16e53b2b32f7">
                              <SHORT-NAME>TcpIpIpV6Ctrl</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies an Internet Protocol version 6 (IPv6) instance.</L-2>
                                <L-2 L="ZH">概述：TcpIpIpV6Ctrl配置项是用于定义TCP/IP协议栈中IPv6控制器的相关属性，这些属性包括IPv6地址配置、多播配置、邻居发现协议参数等。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpIpV6Ctrl时，需要确保IPv6地址的唯一性和正确性，遵循IPv6地址分配和管理的相关规范；同时，要注意IPv6特有的配置项，如邻居发现协议的参数，必须符合网络通信的实际需求和性能要求；此外，如果系统同时支持IPv4和IPv6，应确保两者的配置不会相互冲突，并且能够平稳协同工作。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00096</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <REFERENCES>
                                <ECUC-REFERENCE-DEF UUID="ECUC:d97ba8a6-2905-4950-ad19-3a93bf237162">
                                  <SHORT-NAME>TcpIpIpV6DhcpConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to DHCPv6 configuration.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6DhcpConfigRef 是一个配置引用，用于将TCP/IP协议栈中的IPv6配置与DHCPv6客户端配置关联起来，以便自动获取网络配置参数。</L-2>
                                    <L-2 L="ZH">注意：在配置TCP/IP协议栈时，需要确保引用的DHCPv6配置与网络接口的实际需求相匹配；如果系统不使用DHCPv6服务，则不应配置此引用；在配置时应注意版本兼容性，确保引用的配置项符合AUTOSAR CP 4.4标准。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv6 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00101</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV6Config/TcpIpDhcpV6Config</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF UUID="ECUC:ef1d9fe9-5af0-4726-a80a-533d49962b24">
                                  <SHORT-NAME>TcpIpIpV6FragmentationConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to IPv6 Fragmentation Configuration.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6FragmentationConfigRef 是一个配置参考，它指向用于IPv6分片的配置参数集合，这些参数定义了如何处理发送和接收的IPv6分片数据包。</L-2>
                                    <L-2 L="ZH">注意：在配置IPv6通信时，必须确保分片参数与网络需求和性能目标相匹配；AUTOSAR CP 4.4标准中可能有特定的限制或默认值，需要参考标准文档以确保一致性；如果系统不需要IPv6分片或者网络硬件已经支持分片处理，可能不需要配置此项。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv6 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00103</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV6Config/TcpIpIpV6FragmentationConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF UUID="ECUC:27e9f8ba-6f15-4101-b0e2-03bcf8c03484">
                                  <SHORT-NAME>TcpIpIpV6NdpConfigRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to Neighbor Discovery Protocol Configuration.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6NdpConfigRef是一个配置项，用于引用IPv6邻居发现协议（NDP）的配置参数，这些参数对于IPv6网络通信至关重要，包括地址解析和路由发现等功能。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpIpV6NdpConfigRef时，必须确保引用的NDP配置参数与网络需求相匹配；此配置项对于IPv6通信的性能和可靠性有直接影响；AUTOSAR CP 4.4标准中，确保该配置项正确引用了所有必要的NDP参数，避免配置错误导致网络通信故障。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">(Multiple IPv6 instances may use the same configuration container but will operate independently)</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00102</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpIpConfig/TcpIpIpV6Config/TcpIpNdpConfig</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0788fd66-d075-4d63-ae3e-39be08b80f15">
                                  <SHORT-NAME>TcpIpIpV6MtuConfig</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container specifies the Maximum Transmission Unit parameters for this IPv6 instance.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6MtuConfig 配置项用于定义IPv6网络接口的最大传输单元（MTU），这是任何传输的IPv6数据包的最大允许大小。</L-2>
                                    <L-2 L="ZH">注意：MTU值必须至少为1280字节，这是IPv6协议的最小MTU要求；过大的MTU值可能导致数据包在网络中被分片，影响性能；在配置MTU时，还需考虑网络中其他设备的MTU限制以确保兼容性。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00104</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:31173027-f0ec-49e7-805d-b7c8587a40bf">
                                      <SHORT-NAME>TcpIpIpV6PathMtuEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the IPv6 processes incoming ICMPv6 &quot;Packet Too Big&quot; messages and stores a MTU value for each destination address.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIpV6PathMtuEnabled 是一个配置项，用于启用或禁用IPv6路径最大传输单元（Path MTU）发现机制，该机制允许网络设备确定沿给定路径可传输的最大数据包大小。</L-2>
                                        <L-2 L="ZH">注意：在配置此项时，应考虑网络的实际需求和性能影响；如果启用，确保网络设备和中间设备支持IPv6路径MTU发现；在AUTOSAR CP 4.4标准中，此配置项应与其他网络配置参数协同工作，以确保网络通信的有效性和效率。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">See RFC1981 &quot;Path MTU Discovery for IP version 6&quot; for details about PathMTU.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00107</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0fabb159-2112-4f62-a979-d30a25fc6921">
                                      <SHORT-NAME>TcpIpIpV6PathMtuTimeout</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If this value is &gt;0 the IpV6 will reset the MTU value stored for each destination after n seconds.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIpV6PathMtuTimeout配置项用于定义IPv6路径最大传输单元（Path MTU）发现过程中，等待路径MTU增大确认的超时时间。</L-2>
                                        <L-2 L="ZH">注意：该值应根据网络条件和通信需求谨慎设置，以避免因超时设置不当导致的数据传输效率低下或通信中断；在AUTOSAR CP 4.4标准中，确保该配置项的值符合网络协议栈的性能要求；不同网络环境下可能需要调整该超时时间以获得最佳性能。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">see [RFC1981 5.3. Purging stale PMTU information]
                                                                        Default: 600 seconds (10 minutes)</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00105</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>600</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">86400</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">1</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </CHOICES>
                        </ECUC-CHOICE-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c6c40a77-9641-482f-9b27-5b2e20c15017">
                      <SHORT-NAME>TcpIpDuplicateAddressDetectionConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the DAD callout function.</L-2>
                        <L-2 L="ZH">概述：TcpIpDuplicateAddressDetectionConfig 是一个配置参数，用于定义TCP/IP协议栈中地址冲突检测（Duplicate Address Detection, DAD）的相关参数，这通常用于IPv6地址配置过程中，以确保网络中不会有重复的IP地址。</L-2>
                        <L-2 L="ZH">注意：在配置TcpIpDuplicateAddressDetectionConfig时，需要确保参数设置符合网络的实际需求和IPv6协议的规范；此外，对于不同的网络接口可能需要不同的DAD配置；在AUTOSAR CP 4.4标准中，应当遵循相关的模块配置规则和参数取值范围。</L-2>
                        <L-2 L="ZH">该配置项未使用</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00214</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:2b65cbe5-8396-4308-b6da-de190f39fa33">
                          <SHORT-NAME>TcpIpDuplicateAddressDetectionCalloutName</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the name of the DAD callout function &lt;Up_DADAddressConflict&gt;.</L-2>
                            <L-2 L="ZH">概述：TcpIpDuplicateAddressDetectionCalloutName 是一个配置参数，用于指定一个回调函数的名称，该函数在TCP/IP协议栈执行地址重复检测（Duplicate Address Detection, DAD）过程时被调用。</L-2>
                            <L-2 L="ZH">注意：在配置该参数时，需要确保提供的回调函数名称在系统中是唯一的，并且已经实现了相应的功能；此回调函数应当能够处理地址重复检测的结果，并执行相应的动作；该配置项的使用应当符合IPv6地址分配和管理的相关规范。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00216</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                            <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                      </PARAMETERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d38746e8-ac51-40a5-8459-3b394b231931">
                      <SHORT-NAME>TcpIpIpConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the configuration parameters of the IP (Internet Protocol) sub-module</L-2>
                        <L-2 L="ZH">概述：TcpIpIpConfig配置项用于定义TCP/IP协议栈的IP相关配置，包括IPV4的配置和IPV6的配置（如果支持）。</L-2>
                        <L-2 L="ZH">注意：当前不支持IPV6，无需配置IPV6的功能，只需配置IPV4相关的ICMP，分片和ARP配置。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00022</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:3497f2c5-5cee-4740-99a5-763cd0149596">
                          <SHORT-NAME>TcpIpIpV4Config</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the configuration parameters of the IPv4 (Internet Protocol version 4) sub-module.</L-2>
                            <L-2 L="ZH">概述：TcpIpIpV4Config配置项用于定义TCP/IP协议栈中IPv4的相关配置，包括ICMPv4，IPv4分片重组，ARP配置。</L-2>
                            <L-2 L="ZH">注意：当前不支持IPV6，无需配置IPV6的功能，只需配置IPV4相关的ICMP，分片和ARP配置。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00095</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SUB-CONTAINERS>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:791e29c8-1f23-4fc5-8556-e69a52e7f4ee">
                              <SHORT-NAME>TcpIpArpConfig</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of the ARP (Address Resolution Protocol) sub-module.</L-2>
                                <L-2 L="ZH">概述：TcpIpArpConfig配置项用于定义TCP/IP协议栈中ARP（地址解析协议）的相关参数，包括ARP表的大小、ARP条目的生命周期等，以支持网络通信中的IP地址到物理地址的映射。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpArpConfig时，需要确保ARP表的大小与网络环境相匹配，避免因表过小而频繁更新；ARP条目的生命周期应根据网络稳定性合理设置，以减少网络通信延迟；AUTOSAR CP 4.4标准中对ARP的配置和管理提供了详细规范，确保配置符合标准要求。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00023</RELATED-TRACE-ITEM-REF>
                              <!-- Restricted to creating only one config-->
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d850fca5-70d8-421e-bb1a-2df59a40731c">
                                  <SHORT-NAME>TcpIpArpPacketQueueEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of the ARP Packet Queue according to IETF RFC 1122, section 2.3.2.2.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpPacketQueueEnabled配置项用于启用或禁用在等待ARP响应时对IP数据包的队列处理功能，以控制在ARP解析过程中数据包的处理方式。</L-2>
                                    <L-2 L="ZH">注意：在启用此功能时，系统将会缓存等待ARP响应的IP数据包，直到收到响应或超时；禁用此功能可能导致在ARP解析期间发送的数据包丢失；此配置项对网络性能和资源利用率有直接影响，应根据实际网络条件和应用需求谨慎配置。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:CfgUnrealized">
                                        <SD GID="VCOS:CfgLock">true</SD>
                                        <SD GID="VCOS:CfgValue">true</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00170</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:56ba6fa6-d304-49db-bc75-9a6648233031">
                                  <SHORT-NAME>TcpIpArpPacketQueueLength</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">The maximum number of packets which may be queued for each unresolved address by other network layers.</L-2>
                                    <L-2 L="ZH">概述：用于指定ARP（地址解析协议）中每个目标IP地址的队列长度。这队列用于暂存待发送的数据包。</L-2>
                                    <L-2 L="ZH">注意：默认值为3。所有ARP表项数量之和不能超过MEMP_NUM_ARP_QUEUE，否则内存不足。当队列满时，旧的数据包会被丢弃，新数据包则会进入队列。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00052</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>30</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:cfb4e9a8-9b8e-4ce3-98e7-38da409fccf3">
                                  <SHORT-NAME>TcpIpArpRequestTimeout</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies a timeout in seconds for the validity of ARP requests. After the transmission of an ARP request the TcpIp shall skip the transmission of any further ARP requests to the same destination within a duration of TcpIpArpRequestTimeout seconds. (IETF RFC 1122, section 2.3.2.1) The value for this parameter shall be an integral multiple of TcpIpMainFunctionPeriod or 0. If this parameter set to 0 this features is disabled and no delay between ARP requests is enforced.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpRequestTimeout 配置项用于定义发送ARP（地址解析协议）请求后等待ARP响应的超时时间，这个时间值决定了系统在重新发送ARP请求前将等待多久。</L-2>
                                    <L-2 L="ZH">注意：该值应当根据网络的具体延迟和负载情况进行调整，以避免不必要的网络流量或连接延迟；超时时间设置过短可能导致ARP请求频繁重发，增加网络负担；设置过长可能导致网络响应缓慢，影响通信效率。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:Display">
                                        <SD GID="VCOS:BaseUnit">s</SD>
                                      </SDG>
                                      <SDG GID="VCOS:CfgUnrealized">
                                        <SD GID="VCOS:CfgLock">true</SD>
                                        <SD GID="VCOS:CfgValue">1</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00218</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="OPEN">Inf</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:a62e5598-bc2e-461c-b8f6-ef70766a1279">
                                  <SHORT-NAME>TcpIpArpTableEntryTimeout</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Timeout in seconds after which an unused ARP entry is removed.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpTableEntryTimeout 配置项定义了在ARP（地址解析协议）表中一个条目在没有被刷新的情况下可以保持的最大时间，超过这个时间后，该条目会从ARP表中移除。</L-2>
                                    <L-2 L="ZH">注意：该值需要根据网络的具体情况进行调整，以避免因为过快的移除有效的ARP条目而导致不必要的网络流量；同时，设置过长的超时时间可能会导致ARP表中保留过时的无效条目，影响网络性能；在AUTOSAR CP 4.4标准中，该配置项的具体数值应当符合网络设计要求和资源限制。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:Display">
                                        <SD GID="VCOS:BaseUnit">s</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00053</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:3d712705-1a22-4872-8c8d-dd00b306f64e">
                                  <SHORT-NAME>TcpIpArpNumGratuitousARPonStartup</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the number of gratuitous ARP replies which shall be sent on assignment of a new IP address.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpNumGratuitousARPonStartup 配置项定义了在网络启动时发送的免费ARP（Gratuitous ARP）消息的数量，用于更新其他网络节点上的ARP缓存，以通知它们本节点的IP地址映射。</L-2>
                                    <L-2 L="ZH">注意：该值应根据网络的具体需求和特性来配置，以确保网络中的其他节点能够及时更新ARP缓存；过多的免费ARP消息可能导致网络拥塞，而过少可能导致ARP缓存更新不及时；在配置此项时，还应考虑到启动时网络的负载和性能影响。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:CfgUnrealized">
                                        <SD GID="VCOS:CfgLock">true</SD>
                                        <SD GID="VCOS:CfgValue">1</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00054</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:56ba6fa6-d304-49db-bc75-9a6648233031">
                                  <SHORT-NAME>TcpIpArpTableSizeMax</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Maximum number of entries in the ARP table.</L-2>
                                    <L-2 L="ZH">概述：TcpIpArpTableSizeMax 配置项用于定义TCP/IP协议栈中ARP（地址解析协议）表的最大尺寸，这个尺寸决定了可以缓存多少个IP地址到MAC地址的映射关系。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpArpTableSizeMax时，需要确保其值不超过网络环境中可能出现的最大设备数；过大的ARP表可能会增加内存消耗，而过小的ARP表可能导致频繁的ARP广播，影响网络性能；此配置项的设置应当与实际的网络拓扑和通信需求相匹配。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00052</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="a768cd34-9ec8-48a0-80df-89635ce68e08">
                                  <SHORT-NAME>TcpIpStaticArpEntry</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container includes a static IP address to physical address mapping.</L-2>
                                    <L-2 L="ZH">概述：TcpIpStaticArpEntry 配置项用于定义静态ARP（地址解析协议）表项，这些表项将IP地址映射到固定的物理硬件地址，通常用于网络通信中的地址解析。</L-2>
                                    <L-2 L="ZH">注意：在配置静态ARP表项时，确保IP地址与物理地址的映射是正确且必要的；静态ARP条目通常用于网络设备或关键节点，以避免ARP广播引起的延迟；在AUTOSAR CP 4.4中，应当遵循标准的配置方法和格式，以确保网络栈的正确运行。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS2:CfgPostBuild">
                                        <SD GID="VCOS2:postBuildSelectableChangeable">false</SD>
                                        <SD GID="VCOS2:postBuildNotDeletable">true</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <REQUIRES-INDEX>false</REQUIRES-INDEX>
                                  <PARAMETERS>
                                    <ECUC-STRING-PARAM-DEF UUID="f1ceebbd-85f7-4df7-b9c6-a8c7cb024d5d">
                                      <SHORT-NAME>TcpIpStaticArpEntryIpAddr</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">IPv4 Address</L-4>
                                      </LONG-NAME>
                                      <DESC>
                                        <L-2 L="EN">This parameter defines the IP address that shall be statically mapped to the physical address defined in IpV4StaticArpEntryPhysAddr</L-2>
                                        <L-2 L="ZH">概述：TcpIpStaticArpEntryIpAddr 配置项用于定义静态ARP表中的IP地址，这是网络通信中用于将IP地址映射到物理MAC地址的过程的一部分。</L-2>
                                        <L-2 L="ZH">注意：在配置静态ARP条目时，需要确保IP地址与网络拓扑和地址分配策略一致；静态ARP条目通常用于网络设备或关键节点，以减少ARP广播和提高通信效率；在AUTOSAR CP 4.4标准中，应遵循相关的网络配置规范，确保配置的正确性和网络的稳定性。</L-2>
                                      </DESC>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <MULTIPLICITY-CONFIG-CLASSES>
                                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      </MULTIPLICITY-CONFIG-CLASSES>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                      <REQUIRES-INDEX>false</REQUIRES-INDEX>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <ECUC-STRING-PARAM-DEF-VARIANTS>
                                        <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                          <MAX-LENGTH>15</MAX-LENGTH>
                                          <MIN-LENGTH>7</MIN-LENGTH>
                                        </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                                    </ECUC-STRING-PARAM-DEF>
                                    <ECUC-STRING-PARAM-DEF UUID="b0e5ab81-c88d-491f-8a24-870389090458">
                                      <SHORT-NAME>TcpIpStaticArpEntryPhysAddr</SHORT-NAME>
                                      <LONG-NAME>
                                        <L-4 L="EN">Physical Address</L-4>
                                      </LONG-NAME>
                                      <DESC>
                                        <L-2 L="EN">This parameter defines the physical address that shall be used for outgoing packets to the IP address specified in IpV4StaticArpEntryIpAddr</L-2>
                                        <L-2 L="ZH">概述：TcpIpStaticArpEntryPhysAddr配置项用于定义静态ARP表中条目的物理地址，即MAC地址，这有助于网络通信中的IP地址与物理地址的映射。</L-2>
                                        <L-2 L="ZH">注意：在配置静态ARP条目时，确保物理地址的格式正确且与网络中的实际硬件地址相匹配；静态ARP条目应谨慎使用，以避免网络上的地址冲突；此配置项在AUTOSAR CP 4.4中应与网络配置和安全策略保持一致。</L-2>
                                      </DESC>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <MULTIPLICITY-CONFIG-CLASSES>
                                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      </MULTIPLICITY-CONFIG-CLASSES>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                      <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                      <REQUIRES-INDEX>false</REQUIRES-INDEX>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <ECUC-STRING-PARAM-DEF-VARIANTS>
                                        <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                          <MAX-LENGTH>17</MAX-LENGTH>
                                          <MIN-LENGTH>17</MIN-LENGTH>
                                        </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                                    </ECUC-STRING-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0b070214-55ae-41cc-83da-b1a112ced537">
                              <SHORT-NAME>TcpIpIcmpConfig</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of the ICMP (Internet Control Message Protocol) sub-module.</L-2>
                                <L-2 L="ZH">概述：TcpIpIcmpConfig配置项用于定义TCP/IP协议栈中ICMP(Internet Control Message Protocol)的相关参数，这包括ICMP消息的处理方式、错误消息的生成条件等，以确保网络通信的正确性和高效性。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpIcmpConfig时，需要确保ICMP消息类型和错误代码的正确性和适用性；AUTOSAR CP 4.4标准可能对某些ICMP参数的支持有具体要求或限制，需仔细参考标准文档；配置错误可能导致网络通信故障或性能下降。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00024</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2079bdfa-c9fc-47e3-8a37-648113483468">
                                  <SHORT-NAME>TcpIpIcmpEchoReplyEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Enables or disables transmission of ICMP echo reply message in case of a ICMP echo reception.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpEchoReplyEnabled配置项用于启用或禁用ICMP（Internet Control Message Protocol）回声应答功能，这是网络通信中用于诊断网络连接问题的一种机制。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保网络管理策略与此配置项相协调，以避免潜在的安全风险；此配置项对于网络诊断和远程通信的可靠性至关重要，应谨慎启用；在低带宽或高安全要求的网络环境中，可能需要禁用此功能以优化性能和安全性。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:CfgUnrealized">
                                        <SD GID="VCOS:CfgLock">true</SD>
                                        <SD GID="VCOS:CfgValue">true</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00213</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:2079bdfa-c9fc-47e3-8a37-648113483468">
                                  <SHORT-NAME>TcpIpIcmpUnreachReplyEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Enables or disables transmission of ICMP unreach reply message in case of a Unreachable UDP reception.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpUnreachReplyEnabled配置项用于启用或禁用ICMP不可达消息的回复功能，当IP层无法将数据包传递给上层时，此功能决定是否发送ICMP不可达消息给发送者。</L-2>
                                    <L-2 L="ZH">注意：在配置此项时，应考虑网络安全策略和资源使用情况；过多的ICMP不可达消息可能会导致网络拥塞或被用于网络攻击；AUTOSAR CP 4.4标准中此配置项的默认行为应明确指定，以避免实现差异。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00213</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cf33a86b-8a99-46c4-bc95-ffef25aee441">
                                  <SHORT-NAME>TcpIpIcmpTtl</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Default Time-to-live value of outgoing ICMP packets.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpTtl 配置项用于定义在TCP/IP协议栈中，ICMP（Internet Control Message Protocol）数据包的生存时间（Time To Live），即数据包在网络中可以经过的最大路由器数目。</L-2>
                                    <L-2 L="ZH">注意：该值通常设置为一个较小的固定数值，如64或128，以防止数据包在网络中无限循环；不同的操作系统或网络设备可能有默认的TTL值，需确保在AUTOSAR环境中的设置与网络环境兼容；在AUTOSAR CP 4.4标准中，确保该配置项符合通信堆栈模块的要求。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00055</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:fedcd0fc-df6f-4bd2-99f2-ec03cd9683f4">
                                  <SHORT-NAME>TcpIpIcmpMsgHandler</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container is a subcontainer of TcpIpIcmpConfig and specifies the configuration parameters for the ICMP message handler.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpMsgHandler配置项用于定义网络层的ICMP(Internet Control Message Protocol)消息处理策略，包括如何响应接收到的ICMP请求（如ping请求）。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpIcmpMsgHandler时，需要确保所选策略与系统的安全和性能要求相匹配；不当的ICMP处理策略可能导致网络安全风险；AUTOSAR CP 4.4标准中对ICMP消息的处理提供了灵活性，但需谨慎选择以避免潜在的网络拥塞。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00056</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:141de9ca-67c5-4124-b8e2-13d1a3648569">
                                      <SHORT-NAME>TcpIpIcmpMsgHandlerName</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">This parameter defines the name of the ICMP message handler function &lt;Up_IcmpMsgHandler&gt;.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIcmpMsgHandlerName 是一个配置项，用于指定处理ICMP（Internet Control Message Protocol）消息的模块或函数的名称，这在网络通信中用于错误消息传递和诊断目的。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保指定的处理器名称与实际实现的模块或函数名称一致；处理器应能妥善处理所有预期的ICMP消息类型；配置时需考虑系统的安全性和性能影响。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00057</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:79e223bc-f00b-46a9-93ad-1c26f521eb81">
                              <SHORT-NAME>TcpIpIpFragmentationConfig</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of IPv4 packet fragmentation/reassembly.</L-2>
                                <L-2 L="ZH">概述：TcpIpIpFragmentationConfig 是一个配置参数，用于定义TCP/IP协议栈中IP分片的行为，包括是否允许分片以及分片的具体参数。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，需要确保网络栈配置与IP分片需求相匹配；过大的分片可能会导致网络效率降低，而过小的分片可能会增加处理的复杂性；此外，某些网络环境可能不支持IP分片，因此在设计时需考虑目标部署环境。</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container may be referenced by multiple IPv4 instances if they shall use the same configuration.
                                                        This container may have multiple instances if different configurations are required for different IPv4 instances.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00108</RELATED-TRACE-ITEM-REF>
                              <!-- Restricted to creating only one config-->
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:4dc11a0a-d64b-464e-8f8a-1cfdc1d3d20e">
                                  <SHORT-NAME>TcpIpIpFragmentationTxEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Enables (TRUE) or disables (FALSE) support for fragmentation of output datagrams according to IETF RFC 815.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpFragmentationTxEnabled配置项用于启用或禁用TCP/IP协议栈在传输时的IP分片功能，这决定了系统是否能够将大于网络MTU的数据包分割成较小的片段进行发送。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保网络带宽和处理能力与IP分片功能的开启状态相匹配；过度使用IP分片可能会增加网络延迟和处理开销；在设计系统通信策略时，应考虑到目标网络环境的特性和限制。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00077</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:4dc11a0a-d64b-464e-8f8a-1cfdc1d3d20e">
                                  <SHORT-NAME>TcpIpIpFragmentationRxEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Enables (TRUE) or disables (FALSE) support for reassembling of incoming datagrams that are fragmented according to IETF RFC 815 (IP Datagram Reassembly Algorithms).</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpFragmentationRxEnabled 配置项用于启用或禁用TCP/IP协议栈中接收IP分片的功能，这是网络通信中处理大于最大传输单元（MTU）的数据包所必需的。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与系统的内存和性能要求相匹配；如果系统资源有限，接收大量的IP分片可能会导致性能下降；此外，需要考虑网络安全方面的影响，因为IP分片可能会被用于恶意目的。</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00077</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:dfec7528-59c6-4600-b339-c79bf4009a60">
                                  <SHORT-NAME>TcpIpIpReassTimeout</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the timeout in [s] after which an incomplete datagram gets discarded.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpReassTimeout 配置项用于定义TCP/IP协议栈中IP分片重组的超时时间，即在多长时间内未完成分片重组则放弃重组过程，释放相关资源。</L-2>
                                    <L-2 L="ZH">注意：该值需要根据网络条件和应用场景合理设置，以避免过早放弃重组导致数据丢失，或过长等待导致资源占用；在AUTOSAR CP 4.4标准中，该配置项的单位通常是毫秒，确保与系统定时器分辨率兼容；超时值过小可能导致在高延迟网络中频繁重组失败，而超时值过大可能会导致系统资源长时间被占用。</L-2>
                                  </DESC>
                                  <ADMIN-DATA>
                                    <SDGS>
                                      <SDG GID="VCOS:Display">
                                        <SD GID="VCOS:BaseUnit">s</SD>
                                      </SDG>
                                    </SDGS>
                                  </ADMIN-DATA>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Note: this parameter is only relevant if TcpIpIpFragmentationRxEnabled is TRUE.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00079</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>60</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:904434d7-6541-40cf-a853-01ebabe87739">
                                  <SHORT-NAME>TcpIpIpNumFragments</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the maximum number of IP fragments per datagram.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpNumFragments 配置项用于定义TCP/IP协议栈中，IP层可以同时处理的IP分片数量，这个参数影响着网络通信中数据包的处理能力。</L-2>
                                    <L-2 L="ZH">注意：在设置TcpIpIpNumFragments时，需要确保值不超过系统资源允许的最大值；过低的设置可能导致在高数据流量下丢包；此配置项应与网络通信的预期负载和系统内存资源相匹配。</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Note: this parameter is only relevant if TcpIpIpFragmentationRxEnabled is TRUE.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00078</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>10</DEFAULT-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:511e8838-e4db-4ce5-9fa5-c6b4486e71e0">
                                  <SHORT-NAME>TcpIpIpNumReassDgrams</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the maximum number of fragmented IP datagrams that can be reassembled in parallel.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpNumReassDgrams配置项用于定义系统能够同时重组的IP数据报的最大数量，这有助于管理内存资源并防止拒绝服务攻击。</L-2>
                                    <L-2 L="ZH">注意：该值应根据系统的内存资源和网络需求谨慎配置；过低的值可能导致在高负载下数据报无法被正确重组，过高的值可能会消耗过多的系统资源。此配置项在AUTOSAR CP 4.4中应确保与系统的实际网络吞吐量和内存容量相匹配。</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Note: this parameter is only relevant if TcpIpIpFragmentationRxEnabled is TRUE.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00080</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:1bfb6040-697e-4c60-b523-6b724c75d401">
                          <SHORT-NAME>TcpIpIpV6Config</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the configuration parameters of the IPv6 (Internet Protocol version 6) sub-module.</L-2>
                            <L-2 L="ZH">概述：TcpIpIpV6Config 是一个配置容器，它包含了IPv6协议栈的相关配置参数，用于定义IPv6通信的各种属性，如地址配置、邻居发现协议参数等。</L-2>
                            <L-2 L="ZH">注意：在配置TcpIpIpV6Config时，需要确保IPv6地址的唯一性和正确的子网划分；必须符合网络的实际需求和IPv6标准；在多网卡系统中，还需注意不同网络接口间的地址配置不冲突。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00168</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SUB-CONTAINERS>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:085e89e9-8af0-4c12-ba03-35fa172ee64c">
                              <SHORT-NAME>TcpIpDhcpV6Config</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of the DHCPv6.</L-2>
                                <L-2 L="ZH">概述：TcpIpDhcpV6Config配置项用于定义IPv6环境下，通过DHCP（动态主机配置协议）获取网络配置参数的相关设置，包括地址分配、续租时间等。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpDhcpV6Config时，需确保网络环境支持IPv6和DHCPv6；正确配置续租和重试策略，以避免网络连接中断；AUTOSAR CP 4.4标准中对DHCPv6的支持可能与某些特定网络设备或软件的实现有差异，需要进行兼容性测试。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container may be referenced by multiple IPv6 instances if they shall use the same configuration.
                                                        This container may have multiple instances if different configurations are required for different IPv6 instances.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00110</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <PARAMETERS>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ef862df2-5de6-43de-95f1-ff669c77447b">
                                  <SHORT-NAME>TcpIpDhcpV6CnfDelayMax</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Maximum delay (s) before sending the first Confirm message. If this value is bigger than the previous minimum delay value a random delay will be chosen from the interval.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6CnfDelayMax 是一个配置参数，用于指定在DHCPv6客户端启动配置过程前等待的最大时间，以随机延迟的方式减少网络上的冲突和拥塞。</L-2>
                                    <L-2 L="ZH">注意：该值应当设置为一个合理的时间间隔，以确保网络上的多个DHCPv6客户端不会同时发送配置请求；过大的延迟可能会导致网络配置的不必要延迟；该参数的设置必须遵循RFC 3315中关于DHCPv6客户端行为的规定。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00116</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:b33648e0-0dfa-4343-b66c-e2c4fca2ee50">
                                  <SHORT-NAME>TcpIpDhcpV6CnfDelayMin</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Minimum delay (s) before the first Confirm message will be sent.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6CnfDelayMin配置项定义了在DHCPv6客户端启动配置过程中，发送第一条Solicit消息前的最小延迟时间，用于避免网络上的DHCPv6客户端同时发送消息导致的冲突。</L-2>
                                    <L-2 L="ZH">注意：该值应小于或等于TcpIpDhcpV6CnfDelayMax值，以确保延迟时间的设置逻辑正确；配置值应根据网络环境合理设置，以减少启动时的网络拥塞；AUTOSAR CP 4.4标准中对此参数的具体数值没有强制要求，但建议遵循RFC 3315中的建议。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00117</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ba510b4a-48e7-44cd-88a6-e39afd65a8ee">
                                  <SHORT-NAME>TcpIpDhcpV6InfDelayMax</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Maximum delay (s) before sending the first Information Request message. If this value is bigger than the previous minimum delay value a random delay will be chosen from the interval.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6InfDelayMax 配置项定义了在DHCPv6信息请求过程中，客户端在发送第一条信息请求消息前等待的最大时间。</L-2>
                                    <L-2 L="ZH">注意：该值通常用于控制客户端启动DHCPv6信息请求之前的延迟，以减少网络上的DHCPv6请求冲突；该参数的设置应考虑网络条件和客户端数量；在AUTOSAR CP 4.4标准中，该值应符合RFC 3315中定义的DHCPv6协议要求。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00118</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:05e38d5c-c79b-4494-8b84-9948ffdd2057">
                                  <SHORT-NAME>TcpIpDhcpV6InfDelayMin</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Minimum delay (s) before the first Information Request message will be sent.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6InfDelayMin配置项定义了在DHCPv6信息请求过程中，客户端在发送第一条信息请求消息前的最小延迟时间。</L-2>
                                    <L-2 L="ZH">注意：该值应小于或等于TcpIpDhcpV6InfDelayMax值，以避免配置错误；确保设置的延迟时间不会对网络启动时间产生负面影响；AUTOSAR CP 4.4标准中对此参数的具体数值没有强制要求，但建议遵循RFC 8415中的建议值。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00119</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:e4b749bf-827c-41d4-8fa5-c42b52fc0654">
                                  <SHORT-NAME>TcpIpDhcpV6SolDelayMax</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Maximum delay (s) before sending the first Solicit message. If this value is bigger than the previous minimum delay value a random delay will be chosen from the interval.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6SolDelayMax配置项定义了在发送第一个DHCPv6 Solicit消息前等待的最大时间，用于DHCPv6客户端在启动时减少网络上的冲突和拥塞。</L-2>
                                    <L-2 L="ZH">注意：该值应大于或等于TcpIpDhcpV6SolDelayMin配置项的值；配置过大可能导致网络连接延迟；不符合AUTOSAR CP 4.4标准的配置可能会导致兼容性问题。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00120</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:c6478d4b-9d4c-48e1-bc61-424bdbc8994e">
                                  <SHORT-NAME>TcpIpDhcpV6SolDelayMin</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Minimum delay (s) before the first Solicit message will be sent.</L-2>
                                    <L-2 L="ZH">概述：TcpIpDhcpV6SolDelayMin配置项定义了在发送第一个DHCPv6 Solicit消息前等待的最小时间，用于减少网络上的DHCPv6请求冲突。</L-2>
                                    <L-2 L="ZH">注意：该时间值应小于或等于TcpIpDhcpV6SolDelayMax值，以保证时间配置的有效性；配置值应考虑网络条件，避免因过短的延迟导致的请求冲突；AUTOSAR CP 4.4标准中此参数的设置对网络启动时间有直接影响，需谨慎配置。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00121</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:0dd0eae9-d6f5-4a34-b6cc-c17de89d0a5d">
                              <SHORT-NAME>TcpIpIcmpV6Config</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of the ICMPv6 (Internet Control Message Protocol for IPv6) sub-module.</L-2>
                                <L-2 L="ZH">概述：TcpIpIcmpV6Config 是用于配置IPv6的ICMP（Internet Control Message Protocol）参数，它定义了如何处理IPv6网络中的ICMP消息，例如错误消息和信息查询消息。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpIcmpV6Config时，需要确保ICMPv6消息类型和代码的正确性，以符合IPv6网络的要求；还需注意ICMPv6的错误处理和速率限制设置，以避免网络拥塞和安全风险；此外，AUTOSAR CP 4.4标准可能对ICMPv6的某些行为有具体要求，应当遵守这些规范以保证网络协议栈的兼容性。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00113</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6226e18c-1523-43ac-b410-f837f9b898e4">
                                  <SHORT-NAME>TcpIpIcmpV6EchoReplyAvoidFragmentation</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">If enabled, the stack will respond only to incoming ICMPv6 Echo Requests (Pings) that fit the MTU of the respective interface, i.e. can be transmitted without IPv6 fragmentation. Only relevant if TcpIpIcmpV6EchoReplyEnabled is enabled.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6EchoReplyAvoidFragmentation 配置项用于控制当TCP/IP协议栈发送ICMPv6 Echo Reply（回显应答）消息时，是否避免IP分片。</L-2>
                                    <L-2 L="ZH">注意：在配置此项时，应考虑网络的最大传输单元（MTU）和预期的数据包大小，以确保数据包不会因过大而被分片；若设置为避免分片，可能需要调整应用层数据的大小以适应MTU限制；此配置项的设置应与网络的实际条件和性能要求相匹配。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00212</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:fee33192-192b-4555-94ad-427f5ddd65fc">
                                  <SHORT-NAME>TcpIpIcmpV6EchoReplyEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">If enabled, the stack will respond to incoming ICMPv6 Echo Requests (Pings).</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6EchoReplyEnabled配置项用于启用或禁用对IPv6 ICMP回显请求（即Ping请求）的回复功能，这对网络诊断和连通性测试至关重要。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保网络堆栈配置正确以支持IPv6 ICMP回显回复；不恰当的配置可能导致网络安全风险；在低带宽或高安全要求的网络环境中，谨慎启用此功能。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00149</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b089550a-9496-4f68-a252-81e4aa468780">
                                  <SHORT-NAME>TcpIpIcmpV6MsgDestinationUnreachableEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Dis/Enables transmission of Destination Unreachable Messages</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6MsgDestinationUnreachableEnabled配置项用于启用或禁用ICMPv6目的地不可达消息的发送，这是网络通信中用于告知发送方目标地址不可达的一种机制。</L-2>
                                    <L-2 L="ZH">注意：在配置此项时，应确保网络通信需求与安全策略之间的平衡；不当的启用或禁用可能会影响网络的故障诊断能力；此配置项的默认值和行为应符合AUTOSAR CP 4.4标准，若有差异需特别注意。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00153</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:19129297-3875-4692-84ff-40c38c90fd66">
                                  <SHORT-NAME>TcpIpIcmpV6MsgParameterProblemEnabled</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">If enabled an ICMPv6 parameter problem message will be sent if a received packet has been dropped due to unknown options or headers that are found in the packet.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6MsgParameterProblemEnabled 配置项用于启用或禁用ICMPv6 Parameter Problem消息的发送，这是IPv6网络中用于报告数据包中存在问题的一种机制。</L-2>
                                    <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与网络管理需求相符合；不正确的配置可能导致网络通信问题；在安全相关的应用中，需谨慎启用以防止潜在的拒绝服务攻击。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">[RFC2460 4. IPv6 Extension Headers]</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00151</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7b37b89a-225e-4634-b39d-a68a9b98c74a">
                                  <SHORT-NAME>TcpIpIcmpV6HopLimit</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Default Hop-Limit value of outgoing ICMPv6 packets.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6HopLimit 配置项用于设置IPv6协议中ICMPv6消息的跳数限制，即在网络中传输的最大跳数（路由器数），用以控制消息的传播范围。</L-2>
                                    <L-2 L="ZH">注意：该值通常设置为255，以确保ICMPv6消息在本地链路上可靠传输；在不同网络环境下可能需要调整此值；在AUTOSAR CP 4.4标准中，确保该配置与网络栈的其他部分设置保持一致性。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00152</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6d345fd1-920b-48df-8659-41d49437ae53">
                                  <SHORT-NAME>TcpIpIcmpV6MsgHandler</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">This container is a subcontainer of TcpIpIcmpConfig and specifies the configuration parameters for the ICMPv6 message handler.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIcmpV6MsgHandler配置项用于定义处理IPv6 ICMP（Internet Control Message Protocol）消息的策略和方法，确保网络通信中的错误和信息能够被正确处理。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpIcmpV6MsgHandler时，需要确保所定义的处理程序与网络需求和安全策略相匹配；此配置项对于网络的稳定性和安全性至关重要，应谨慎配置；AUTOSAR CP 4.4标准中对ICMPv6消息的处理提供了详细的指导，应确保配置与标准一致。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00154</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:d32e4e84-1616-4fc9-a668-edd81884be84">
                                      <SHORT-NAME>TcpIpIcmpV6MsgHandlerName</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">This parameter defines the name of the ICMP message handler function &lt;Up_IcmpMsgHandler&gt;.</L-2>
                                        <L-2 L="ZH">概述：TcpIpIcmpV6MsgHandlerName 是一个配置参数，用于指定处理IPv6 ICMP（Internet Control Message Protocol）消息的回调函数名。</L-2>
                                        <L-2 L="ZH">注意：在配置TcpIpIcmpV6MsgHandlerName时，需要确保所指定的回调函数符合AUTOSAR CP 4.4标准中对ICMPv6消息处理函数的要求；回调函数名应该遵循项目的命名规范，以便于识别和维护；确保该回调函数能够正确处理所有预期的ICMPv6消息类型，以保证网络通信的正确性和可靠性。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00156</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                        <ECUC-FUNCTION-NAME-DEF-CONDITIONAL/>
                                      </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                                    </ECUC-FUNCTION-NAME-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6cf352bb-d2cd-40c6-9e62-c83b7bf74bc9">
                              <SHORT-NAME>TcpIpIpV6ConfigExtHeaderFilter</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container describes the white list for the filtering of IPv6 extension headers, i.e. frames containing IPv6 extension headers not listed here shall be silently dropped.</L-2>
                                <L-2 L="ZH">概述：TcpIpIpV6ConfigExtHeaderFilter 配置项用于定义IPv6通信中，哪些扩展头部应当被过滤或处理，以确保网络栈正确处理接收到的IPv6数据包。</L-2>
                                <L-2 L="ZH">注意：在配置过滤规则时，需要确保与网络安全策略和性能要求相符合；过滤不当可能会导致有效数据包被错误丢弃；AUTOSAR CP 4.4标准中应详细定义了可用的扩展头部类型和过滤规则，因此配置时应参照标准以确保兼容性。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00198</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:de3c3962-9bd9-4f2e-97d2-af816cbef4c3">
                                  <SHORT-NAME>TcpIpIpV6ConfigExtHeaderFilterEntry</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">IPv6 Extension Header type allowed by this filter.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6ConfigExtHeaderFilterEntry配置项用于定义IPv6通信中，对特定扩展头的过滤规则，以决定哪些类型的扩展头应当被接受或拒绝。</L-2>
                                    <L-2 L="ZH">注意：在配置过滤规则时，需确保与网络安全策略一致；不正确的过滤配置可能导致合法数据包被错误地拒绝；AUTOSAR CP 4.4标准中未明确列出对此配置项的具体要求，因此实现时需参考最新的网络协议标准和安全实践。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00199</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:ff573a2c-420e-43c8-a735-f9c42e29e992">
                              <SHORT-NAME>TcpIpIpV6FragmentationConfig</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of IPv6 packet fragmentation/reassembly.</L-2>
                                <L-2 L="ZH">概述：TcpIpIpV6FragmentationConfig 是一个配置参数，用于定义TCP/IP协议栈中IPv6分片的相关配置，包括是否启用IPv6分片和分片的相关参数。</L-2>
                                <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，IPv6分片可能会受到限制或不被推荐使用，因为它可能会影响网络性能和安全性；配置时应确保与网络通信需求和硬件能力相匹配；在设计系统时应考虑到IPv6的路径最大传输单元（PMTU）发现机制，以避免不必要的分片。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container may be referenced by multiple IPv6 instances if they shall use the same configuration.
                                                        This container may have multiple instances if different configurations are required for different IPv6 instances.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00114</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <PARAMETERS>
                                <ECUC-FLOAT-PARAM-DEF UUID="ECUC:3888c521-1ad0-46d0-9a46-c16a5df7babc">
                                  <SHORT-NAME>TcpIpIpV6ReassemblyTimeout</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">[RFC2460 4.5 Fragment Header]</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6ReassemblyTimeout 配置项用于定义IPv6数据包重组过程中等待接收完整数据包的最大时间，超时后未完成重组的数据包将被丢弃。</L-2>
                                    <L-2 L="ZH">注意：该值应根据网络条件和应用需求合理设置，以避免因超时过短而频繁丢弃数据包；同时，过长的超时时间可能会导致系统资源（如内存）被长时间占用；在配置时需确保该值符合AUTOSAR CP 4.4标准中对IPv6重组超时的规定。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">Default: 60 seconds</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00159</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>60</DEFAULT-VALUE>
                                  <MAX INTERVAL-TYPE="CLOSED">100</MAX>
                                  <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:8ce65d0a-af99-4520-bbb8-e4578ada01ef">
                                  <SHORT-NAME>TcpIpIpV6ReassemblyBufferCount</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Number of buffers that can be used for fragment reassembly. In case of a reassembly error or if not all fragments are received in time this buffer will be blocked until the specified &quot;Fragment Reassembly Timeout&quot; has been exceeded.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6ReassemblyBufferCount 配置项用于指定IPv6协议栈中重组缓冲区的数量，这些缓冲区用于存储和重组分片化的IPv6数据包，直到它们可以完整地处理。</L-2>
                                    <L-2 L="ZH">注意：在配置此参数时，需要考虑系统可能同时处理的IPv6分片数据包的最大数量；配置的缓冲区数量不应超过系统资源允许的最大值；此参数的配置应与网络的通信量和系统的内存资源相匹配，以避免内存浪费或缓冲区不足。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">A value of 0 disables fragment reassembly.

                                                                [RFC2460 5. Packet Size Issues]
                                                                &quot;In order to send a packet larger than a path's MTU, a node may use the IPv6 Fragment header to fragment the packet at the source and have it reassembled at the destination(s).  However, the use of such fragmentation is discouraged in any application that is able to adjust its packets to fit the measured path MTU (i.e., down to 1280 octets).&quot;</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00157</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>2</DEFAULT-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7a6aa15a-9f47-4dce-9f7b-fc9e322f7a6d">
                                  <SHORT-NAME>TcpIpIpV6ReassemblyBufferSize</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">[RFC2460 5. Packet Size Issues]</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6ReassemblyBufferSize 配置项用于定义IPv6协议栈中用于重组分片IPv6数据包的缓冲区大小，确保能够处理和重组接收到的IPv6分片。</L-2>
                                    <L-2 L="ZH">注意：缓冲区大小应足够大以容纳最大可能的分片数据包；过小的缓冲区可能导致无法重组大型数据包，而过大的缓冲区则可能浪费系统资源；在配置时还需考虑系统的内存限制和网络通信的实际需求。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">&quot;A node must be able to accept a fragmented packet that, after reassembly, is as large as 1500 octets.  A node is permitted to accept fragmented packets that reassemble to more than 1500 octets.&quot;the measured path MTU (i.e., down to 1280 octets).&quot;</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00158</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1500</DEFAULT-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>1500</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1ed76363-7698-459b-8dea-38134e6cd11b">
                                  <SHORT-NAME>TcpIpIpV6ReassemblySegmentCount</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the maximum number of consecutive data segments that can be managed in each reassembly buffer. If all fragments are received in order, only one segment will be needed.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6ReassemblySegmentCount 配置项用于指定IPv6协议栈在重组IPv6分段时能够处理的最大分段数量，这是为了支持IPv6数据包的分段和重组功能。</L-2>
                                    <L-2 L="ZH">注意：该值必须足够大以支持网络通信中预期的最大分段数；过小的值可能导致无法正确重组分段数据包；在资源受限的系统中，需要平衡内存使用和网络性能。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">To deal with fragments received out of order this value should be configured bigger than 1.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00160</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                  <MAX>255</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:b9ae5792-ede6-4de4-a70e-43c0c89125b7">
                                  <SHORT-NAME>TcpIpIpV6TxFragmentBufferCount</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">These buffers will be used if the IpV6 receives packets from the upper layer that do not fit into the MTU and thus must be fragmented.</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6TxFragmentBufferCount 配置项用于指定IPv6传输层在发送分片数据包时可用的缓冲区数量，这影响着能够同时处理的分片数据包的数量。</L-2>
                                    <L-2 L="ZH">注意：在配置此项时，需要考虑系统的内存资源和网络通信的需求；过多的缓冲区可能会消耗较多内存，而过少可能导致网络传输效率降低；此配置项的合理设置应基于网络负载和硬件能力的评估。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">A value of 0 disables tx fragmentation.

                                                                If the upper layer transmits packets that do not fit into the link or path MTU, the IpV6 will split-up the packet into fragments.

                                                                see &quot;Enable Fragment Reassembly&quot;</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00161</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>2</DEFAULT-VALUE>
                                  <MAX>1000</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:fb6cf60a-e8d5-4932-9397-0f24c1bc9808">
                                  <SHORT-NAME>TcpIpIpV6TxFragmentBufferSize</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Size of each fragment tx buffer in bytes</L-2>
                                    <L-2 L="ZH">概述：TcpIpIpV6TxFragmentBufferSize定义了用于IPv6传输的TCP/IP协议栈中，发送数据包时可用的最大片段缓冲区大小。</L-2>
                                    <L-2 L="ZH">注意：该配置项的大小直接影响数据包的发送性能和效率；过大或过小的缓冲区大小可能导致内存浪费或数据传输延迟；需根据网络条件和应用需求合理配置缓冲区大小。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00162</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <DEFAULT-VALUE>1500</DEFAULT-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>1500</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:c00ddb48-8f52-45f4-b7a4-8d7c273ed0ef">
                              <SHORT-NAME>TcpIpNdpConfig</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Specifies the configuration parameters of the Neighbor Discovery Protocol for IPv6</L-2>
                                <L-2 L="ZH">概述：TcpIpNdpConfig 是用于配置网络发现协议（Neighbor Discovery Protocol, NDP）的参数，这些参数控制着IPv6网络中的地址解析和路由发现等功能。</L-2>
                                <L-2 L="ZH">注意：在配置TcpIpNdpConfig时，需要确保参数符合IPv6网络的要求和AUTOSAR CP 4.4标准；参数设置应考虑网络的实际情况，如网络大小和通信频率；不当的配置可能导致网络通信效率低下或地址解析失败。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <INTRODUCTION>
                                <P>
                                  <L-1 L="EN">This container may be referenced by multiple IPv6 instances if they shall use the same configuration.
                                                        This container may have multiple instances if different configurations are required for different IPv6 instances.</L-1>
                                </P>
                              </INTRODUCTION>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00112</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <SUB-CONTAINERS>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a2ca37fd-706d-4847-8548-9818b79c39e6">
                                  <SHORT-NAME>TcpIpNdpArNudConfig</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the configuration parameters for NDP Address Resolution and Neighbor Unreachability Detection.</L-2>
                                    <L-2 L="ZH">概述：TcpIpNdpArNudConfig是用于配置邻居不可达性检测（Neighbor Unreachability Detection, NUD）的参数，这是IPv6网络中的一项机制，用于监测邻居节点的可达性状态。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpNdpArNudConfig时，需要确保参数设置符合网络的实际需求和特性；不正确的配置可能导致网络通信不稳定或中断；AUTOSAR CP 4.4标准中对于IPv6的支持和配置项有详细规定，需要确保配置与标准一致。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00123</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a9d4e109-b5e0-4475-9395-105b7ea79fb2">
                                      <SHORT-NAME>TcpIpNdpDefensiveProcessing</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the NDP shall only process Neighbor Advertisements which are received in reaction to a previously transmitted Neighbor Solicitation as well as skipping updates to the Neighbor Cache based on received Neighbor Solicitations. If disabled all Neighbor Advertisements and Solicitations shall be processed as specified in RFC4861.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDefensiveProcessing配置项用于定义网络数据包处理过程中的防御机制，以提高网络通信的安全性和可靠性。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，对于IPv6网络配置，需要特别注意该配置项的启用状态，以确保网络层面的安全防护；不当的配置可能导致网络性能下降或安全漏洞；建议仅在面临网络安全威胁时启用该功能。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 7.2.5. Receipt of Neighbor Advertisements]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00201</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:a87216f8-7ec7-4847-8392-ac62131de456">
                                      <SHORT-NAME>TcpIpNdpNeighborUnreachabilityDetectionEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Neighbor Unreachability Detection is used to remove unused entries from the neighbor cache. This feature is a basic feature of NDP and should be turned on.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpNeighborUnreachabilityDetectionEnabled 是一个配置参数，用于启用或禁用网络层的邻居不可达性检测（Neighbor Unreachability Detection, NUD）功能，这是IPv6网络中的一项机制，用于确定目标节点是否仍然可达。</L-2>
                                        <L-2 L="ZH">注意：在配置此项时，应确保它与网络的实际需求和策略相匹配；不正确的配置可能导致网络连接问题；AUTOSAR CP 4.4标准中，此配置应与IPv6协议栈的其他相关配置项协同工作。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00136</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:25de1279-2b1c-4ddb-a066-641a2a996f27">
                                      <SHORT-NAME>TcpIpNdpPacketQueueEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of a NDP Packet Queue according to IETF RFC 4861, section 7.2.2.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpPacketQueueEnabled 配置项用于启用或禁用网络数据包队列，特别是针对邻居发现协议（NDP）的数据包，这有助于管理IPv6网络中的数据流量。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与IPv6堆栈的实现和需求相匹配；如果不使用IPv6或者不需要NDP队列管理功能，可以禁用此选项以节省资源；正确配置此项对于网络性能和资源管理至关重要。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00171</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:3ceb17c7-1357-4510-be88-8736383c7900">
                                      <SHORT-NAME>TcpIpNdpRandomReachableTimeEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the value of ReachableTime will be multiplied with a random value between MIN_RANDOM_FACTOR and MAX_RANDOM_FACTOR in order to prevent multiple nodes from transmitting at exactly the same time</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpRandomReachableTimeEnabled 配置项用于启用或禁用基于随机数的可达时间计算，这是针对IPv6邻居发现协议（NDP）的一种机制，用于确定主机认为邻居是可达的时间长度。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，应确保此配置项与IPv6堆栈的实现和需求相匹配；如果启用，需要有机制生成随机的可达时间，以避免网络同步问题；此配置项的使用应遵循网络设计的安全和性能考虑。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.2. Host Variables / ReachableTime]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00137</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:3fa8fe74-f61c-45ec-b86d-eb75a2e1de8c">
                                      <SHORT-NAME>TcpIpNdpDefaultReachableTime</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Configuration of the ReachableTime (s) specified in [RFC4861 6.3.2. Host Variables].</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDefaultReachableTime 是一个配置参数，用于指定网络接口在认为邻居节点是可达的默认时间（以毫秒为单位），这是IPv6邻居发现协议（NDP）的一部分。</L-2>
                                        <L-2 L="ZH">注意：该值通常是一个推荐的默认值，但可以根据网络条件进行调整；过小的值可能导致频繁的邻居可达性确认，而过大的值可能导致网络变化反应不及时；在AUTOSAR CP 4.4中，确保配置值符合网络栈的性能要求和标准规范。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">&quot;The time a neighbor is considered reachable after receiving a reachability confirmation.&quot;

                                                                        If &quot;TcpIpNdpDynamicReachableTimeEnabled&quot; is checked, this value may be reconfigured based on received Router Advertisements.

                                                                        Default: REACHABLE_TIME = 30 seconds</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00130</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>30</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">120</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:6f3426f6-13aa-40b7-9c26-afdf8fff6e32">
                                      <SHORT-NAME>TcpIpNdpDefaultRetransTimer</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Configures the default value (s) for the RetransTimer variable specified in [RFC4861 6.3.2. Host Variables].</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDefaultRetransTimer配置项定义了在Neighbor Discovery协议中，当等待邻居确认消息时，默认的消息重传时间间隔。</L-2>
                                        <L-2 L="ZH">注意：该时间间隔的配置对网络的响应时间和负载有直接影响；值设置过小可能导致网络拥堵，过大可能导致响应延迟；需根据网络环境和性能要求谨慎配置。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">&quot;The time between retransmissions of Neighbor Solicitation messages to a neighbor when resolving the address or when probing the reachability of a neighbor.&quot;

                                                                        If &quot;TcpIpNdpDynamicRetransTimeEnabled&quot; is checked, this value may be reconfigured based on received Router Advertisements.

                                                                        Default: RETRANS_TIMER = 1 second</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00165</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">60</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:683566f1-6219-4c51-bdcb-d73ed219f6fb">
                                      <SHORT-NAME>TcpIpNdpDelayFirstProbeTime</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Delay before sending the first NUD probe in (s).</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDelayFirstProbeTime配置项用于定义在Neighbor Discovery协议中，从地址解析开始到发送第一个Neighbor Solicitation消息之间的延迟时间。</L-2>
                                        <L-2 L="ZH">注意：该配置项的值应根据网络的具体需求和性能目标进行调整；过小的值可能导致网络拥塞，过大的值可能导致延迟过高；在AUTOSAR CP 4.4标准中，该配置项的具体数值范围和默认值应符合标准规定，若有出入需进行调整。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 7.3.3. Node Behavior]

                                                                        Default: DELAY_FIRST_PROBE_TIME = 5 seconds</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00133</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">60</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cb0d5fd8-e5c1-489b-be27-6912820e20fc">
                                      <SHORT-NAME>TcpIpNdpMaxNeighborCacheSize</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of entries in the neighbor cache.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpMaxNeighborCacheSize定义了在IPv6网络中，TCP/IP协议栈能够缓存的最大邻居发现协议（NDP）条目的数量，用于优化网络通信效率。</L-2>
                                        <L-2 L="ZH">注意：该配置项的值应根据网络的规模和通信频率进行合理设置，以避免缓存溢出或资源浪费；在资源受限的嵌入式系统中，过大的缓存大小可能会影响系统性能；AUTOSAR CP 4.4标准中未明确规定具体的最大或最小值，需参考具体的网络需求和硬件能力进行配置。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 5.1. Conceptual Data Structures]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00129</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                      <MAX>254</MAX>
                                      <MIN>1</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5fafc53c-0bc1-48e8-bc7e-b1746c519e2a">
                                      <SHORT-NAME>TcpIpNdpMaxRandomFactor</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum random factor used for randomization</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpMaxRandomFactor 配置项用于定义Neighbor Discovery协议中重传时间间隔的最大随机因子，这个因子用于计算消息重传的时间间隔，以减少网络上的冲突和拥塞。</L-2>
                                        <L-2 L="ZH">注意：该值通常是一个大于1的浮点数，用于乘以基础重传时间间隔以得到最大重传时间；配置值应遵循RFC 4861中的建议；在实际应用中，需要根据网络的具体情况调整该值以优化网络性能。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 10. Protocol Constants]

                                                                        Default: 15 (MAX_RANDOM_FACTOR = 1.5)</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00135</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>15</DEFAULT-VALUE>
                                      <MAX>100</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5756d2b7-c090-4ec3-a019-3054e27f7638">
                                      <SHORT-NAME>TcpIpNdpMinRandomFactor</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Minimum random factor used for randomization</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpMinRandomFactor配置项用于定义Neighbor Discovery协议中重传时间间隔的最小随机因子，以避免网络上的多个节点在相同时间重发消息，减少网络冲突。</L-2>
                                        <L-2 L="ZH">注意：该配置项的值应小于或等于TcpIpNdpMaxRandomFactor的值，以保证重传时间间隔的随机性有效；在设置时考虑网络的实际情况和性能要求；AUTOSAR CP 4.4标准中对此参数的具体数值范围没有特别限制，但建议根据网络规模和通信需求谨慎选择。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 10. Protocol Constants]

                                                                        Default: 5 (MIN_RANDOM_FACTOR = 0.5)</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00134</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                      <MAX>100</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:510ff5f3-33c7-4170-858c-39b012f2e7ed">
                                      <SHORT-NAME>TcpIpNdpNumMulticastSolicitations</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of multicast solicitations that will be sent when performing address resolution.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpNumMulticastSolicitations配置项定义了在确定邻居不可达之前，发送多播邻居请求消息的最大次数。</L-2>
                                        <L-2 L="ZH">注意：该值必须大于0；过低的值可能导致在高丢包环境下无法可靠地发现邻居，而过高的值可能导致网络拥塞；在AUTOSAR CP 4.4标准中，该配置项的默认值和范围应根据具体的网络需求和性能考虑进行调整。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 7.2.2. Sending Neighbor Solicitations]

                                                                        Default: MAX_MULTICAST_SOLICIT = 3</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00132</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>3</DEFAULT-VALUE>
                                      <MAX>255</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:456f8d3e-d43a-48ce-9f69-8032f880fef1">
                                      <SHORT-NAME>TcpIpNdpNumUnicastSolicitations</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of unicast solicitations that will be sent when performig Neighbor Unreachability Detection.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpNumUnicastSolicitations 配置项定义了在IPv6网络中，为了确定一个单播地址的可达性，发送的单播邻居请求消息的数量。</L-2>
                                        <L-2 L="ZH">注意：该值通常是一个小的正整数，根据网络的具体需求进行配置；过高的值可能导致网络拥塞，而过低的值可能导致地址解析不可靠；在AUTOSAR CP 4.4标准中，应确保该配置项的值符合网络协议栈的要求。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 7.3.3. Node Behavior]

                                                                        Default: MAX_UNICAST_SOLICIT = 3</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00131</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>3</DEFAULT-VALUE>
                                      <MAX>255</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:54b3e5f7-074e-467a-8286-eaf913c95da9">
                                  <SHORT-NAME>TcpIpNdpPrefixRouterDiscoveryConfig</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the configuration parameters for NDP Prefix and Router Discovery.</L-2>
                                    <L-2 L="ZH">概述：TcpIpNdpPrefixRouterDiscoveryConfig配置项用于定义网络层的IPv6邻居发现协议（NDP）中前缀和路由器发现相关的参数，以便正确处理IPv6地址的自动配置和维护。</L-2>
                                    <L-2 L="ZH">注意：在配置此项时，必须确保IPv6网络环境下的兼容性和正确性；该配置对网络性能和通信安全性有直接影响，应谨慎设置；AUTOSAR CP 4.4标准中对于IPv6的支持和配置要求较为详细，需仔细遵守相关规范。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00124</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8a1e918f-7ab6-46b0-9f1f-977676d9d0b1">
                                      <SHORT-NAME>TcpIpNdpDynamicHopLimitEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the default hop limit may be reconfigured based on received Router Advertisements.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDynamicHopLimitEnabled 是一个配置项，用于启用或禁用基于邻居发现协议（NDP）动态确定IPv6数据包的跳数限制（Hop Limit）的功能。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，此配置项应当与IPv6和NDP相关的模块配置保持一致；如果网络栈不需要动态确定跳数限制，该选项应设置为禁用；在启用此功能时，需要确保网络栈正确实现了NDP相关的规范。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.4. Processing Received Router Advertisements]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00147</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:bf2bbcb9-44fd-4de1-b3f1-7d334eb0537f">
                                      <SHORT-NAME>TcpIpNdpDynamicMtuEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Allow dynamic reconfiguration of link MTU via Router Advertisements.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDynamicMtuEnabled 配置项用于启用或禁用网络层发现协议（NDP）的动态最大传输单元（MTU）发现功能，这是IPv6网络中用于确定最优MTU大小的机制。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与IPv6网络堆栈的其他设置兼容；如果启用，网络性能可能会因适应不同网络路径的MTU而提高，但也可能增加网络管理的复杂性；禁用时，系统将使用静态MTU值，可能不是最优的网络路径MTU，但配置简单。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 4.6.4. MTU]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00148</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:381e3f63-8e3f-40fa-8c08-9e83f941dd27">
                                      <SHORT-NAME>TcpIpNdpDynamicReachableTimeEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the default Reachable Time value may be reconfigured based on received Router Advertisements.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDynamicReachableTimeEnabled 是一个配置项，用于启用或禁用基于网络条件动态调整IPv6邻居发现协议（NDP）的可达时间的功能。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，应确保此配置项与IPv6堆栈的实现和网络需求相匹配；如果启用，需要有相应的算法来动态调整可达时间；在禁用时，系统将使用静态的可达时间配置。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.4. Processing Received Router Advertisements]

                                                                        Default: Enabled</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00146</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7839ab89-4cdf-4503-9464-1ea052a5c245">
                                      <SHORT-NAME>TcpIpNdpDynamicRetransTimeEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the default Retransmit Timer value may be reconfigured based on received Router Advertisements.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDynamicRetransTimeEnabled 是一个配置参数，用于启用或禁用TCP/IP协议栈中邻居发现协议（NDP）的动态重传计时器功能，该功能允许根据网络条件调整NDP消息的重传时间间隔。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，应确保此配置项与网络堆栈的实际需求和性能目标相匹配；不正确的配置可能会影响网络通信的效率和可靠性；在配置此项时，还应考虑与其他网络参数的相互作用和依赖性。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.4. Processing Received Router Advertisements]

                                                                        Default: Enabled</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00145</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:919f0a26-5f7c-4de2-ba78-6abb9f5a07e7">
                                      <SHORT-NAME>TcpIpNdpRndRtrSolicitationDelayEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled the first router solicitation will be delayed randomly from [0...MAX_RTR_SOLICITATION_DELAY]. Otherwise the first router solicitation will be sent after exactly MAX_RTR_SOLICITATION_DELAY milliseconds.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpRndRtrSolicitationDelayEnabled 是一个配置项，用于启用或禁用在发送初始路由器请求消息之前的随机延迟，这有助于减少网络上的请求冲突。</L-2>
                                        <L-2 L="ZH">注意：在配置此项时，应确保它与网络需求和性能目标相匹配；如果启用，需要设置合适的随机延迟范围；在高密度网络或启动时网络活动较高的场景中，此功能特别有用。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.7. Sending Router Solicitations]

                                                                        Default: Enabled</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00141</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:fd6052e4-e6f1-4727-a9c1-a377781d7074">
                                      <SHORT-NAME>TcpIpNdpMaxRtrSolicitationDelay</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum delay before the first Router Solicitation will be sent after interface initialization in (s).</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpMaxRtrSolicitationDelay配置项定义了在发送初始路由器请求消息之前等待的最大时间，用于IPv6网络中确定可用路由器的存在。</L-2>
                                        <L-2 L="ZH">注意：该值必须根据网络的具体需求和性能考虑进行配置；过小的值可能导致网络拥塞，过大的值可能导致网络启动延迟；在AUTOSAR CP 4.4标准中，该配置项的具体数值范围和默认值应符合标准规定，若有出入需进行调整。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.7. Sending Router Solicitations]

                                                                        Default: MAX_RTR_SOLICITATION_DELAY = 1 second</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00143</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">60</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:e85690f3-8075-4609-8338-a87a59b46900">
                                      <SHORT-NAME>TcpIpNdpRtrSolicitationInterval</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Interval between consecutive Router Solicitations in (s).</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpRtrSolicitationInterval配置项定义了在IPv6网络中，节点发送路由器请求消息（Router Solicitation messages）的时间间隔，用于发现网络中的路由器设备。</L-2>
                                        <L-2 L="ZH">注意：该时间间隔值必须遵守RFC 4861中定义的最小和最大间隔限制；不正确的配置可能导致网络连接延迟或中断；在动态网络环境中，应考虑调整此值以优化网络性能。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 6.3.7. Sending Router Solicitations]

                                                                        Default: RTR_SOLICITATION_INTERVAL = 4 seconds</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00144</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>4</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">60</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2f684056-2a69-49a8-8e09-3af470055ae0">
                                      <SHORT-NAME>TcpIpNdpDefaultRouterListSize</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of default router entries.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDefaultRouterListSize 配置项用于定义网络层邻居发现协议（NDP）中默认路由器列表的大小，这个列表用于存储IPv6网络中可用的默认路由器信息。</L-2>
                                        <L-2 L="ZH">注意：在配置时需要确保列表大小足以容纳网络中所有必要的默认路由器；过大的列表可能会浪费内存资源，而过小的列表可能导致无法存储所有有效的路由器信息；在AUTOSAR CP 4.4标准中，此配置项应与网络拓扑和通信需求相匹配。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 5.1. Conceptual Data Structures]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00139</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>2</DEFAULT-VALUE>
                                      <MAX>254</MAX>
                                      <MIN>2</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:c4684f8c-eb6a-479a-ac81-8dc4c4e8aabd">
                                      <SHORT-NAME>TcpIpNdpDestinationCacheSize</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of entries in the destination cache.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpDestinationCacheSize配置项用于定义网络层中IPv6邻居发现协议（NDP）的目的地缓存大小，这个缓存用于存储目的地的地址解析信息，以加快数据包的传输。</L-2>
                                        <L-2 L="ZH">注意：在配置TcpIpNdpDestinationCacheSize时，需要考虑网络的规模和通信频率，以确保缓存大小既能满足性能需求又不会过度占用系统资源；此配置项对于优化网络性能至关重要，但设置过大可能会导致不必要的内存消耗；AUTOSAR CP 4.4标准中并未对此配置项的具体数值范围做出明确规定，但建议根据实际应用场景谨慎选择合适的大小。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 5.1. Conceptual Data Structures]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00138</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                      <MAX>254</MAX>
                                      <MIN>1</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:69425bd8-ae79-4810-ba46-4e5c58bb7bfa">
                                      <SHORT-NAME>TcpIpNdpMaxRtrSolicitations</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of Router Solicitations that will be sent before the first Router Advertisement has been received.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpMaxRtrSolicitations配置项定义了在确定网络接口的可达性时，节点发送Router Solicitation消息的最大次数。</L-2>
                                        <L-2 L="ZH">注意：该值应根据网络的具体需求和性能考虑进行配置；过高的值可能导致网络拥塞，而过低的值可能导致节点无法及时发现路由器；在AUTOSAR CP 4.4中，确保此配置与网络的实际需求相匹配。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">0 = No Router Solicitations will be sent.
                                                                        This has no impact on handling Router Advertisements.

                                                                        [RFC4861 6.3.7. Sending Router Solicitations]

                                                                        Default: MAX_RTR_SOLICITATIONS = 3 transmissions</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00142</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>3</DEFAULT-VALUE>
                                      <MAX>255</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:194dcddc-b3ad-4879-a06a-a3ea79c7cac4">
                                      <SHORT-NAME>TcpIpNdpPrefixListSize</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Maximum number of entries in the on-link prefix list.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpPrefixListSize 配置项用于定义网络接口上Neighbor Discovery Protocol（NDP）前缀列表的大小，这个列表包含了IPv6地址前缀，用于地址自动配置和地址解析。</L-2>
                                        <L-2 L="ZH">注意：在配置TcpIpNdpPrefixListSize时，需要确保列表大小能够满足网络接口上可能出现的前缀数量；过大的列表可能会浪费资源，而过小的列表可能导致地址配置失败；此配置项应与网络的实际需求和IPv6地址规划相匹配。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 5.1. Conceptual Data Structures]</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00140</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                      <MAX>254</MAX>
                                      <MIN>1</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                  </PARAMETERS>
                                  <SUB-CONTAINERS>
                                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:780af75e-8302-4cf3-afcc-e016349dc736">
                                      <SHORT-NAME>TcpIpNdpPrefixList</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Specifies a list of prefixes to be treated as &quot;on-link&quot; according to IETF RFC 4861 Section 5.1.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpPrefixList配置项用于定义网络中的IPv6地址前缀列表，这些前缀用于自动配置网络设备的IPv6地址和识别网络中的地址范围。</L-2>
                                        <L-2 L="ZH">注意：在配置IPv6网络参数时，确保前缀长度和值正确匹配网络设计要求；前缀信息通常由网络管理员或自动配置协议如NDP（邻居发现协议）提供；AUTOSAR CP 4.4中对IPv6的支持包括对NDP的配置要求，确保与网络设备和协议栈的兼容性。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00205</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SUB-CONTAINERS>
                                        <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6eb33fbf-d76d-46c4-ac12-a576269eaee4">
                                          <SHORT-NAME>TcpIpNdpPrefixListEntry</SHORT-NAME>
                                          <DESC>
                                            <L-2 L="EN">Single entry in the prefix list.</L-2>
                                            <L-2 L="ZH">概述：TcpIpNdpPrefixListEntry 配置项用于定义IPv6网络中的前缀列表条目，这些条目用于Neighbor Discovery Protocol (NDP) 来管理地址自动配置和路由选择。</L-2>
                                            <L-2 L="ZH">注意：在配置TcpIpNdpPrefixListEntry时，需要确保前缀长度和前缀地址的有效性，以符合IPv6地址规范；此外，要注意前缀信息的一致性，以避免网络通信中的冲突或错误；根据AUTOSAR CP 4.4标准，还需确保配置项与IPv6堆栈的其他部分（如地址配置和路由表）协同工作。</L-2>
                                            <L-2 L="ZH">该配置项未使用</L-2>
                                          </DESC>
                                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00206</RELATED-TRACE-ITEM-REF>
                                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                          <PARAMETERS>
                                            <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e36934d4-ffe9-4ada-a6a6-516de8fcf6b6">
                                              <SHORT-NAME>TcpIpNdpPrefixListEntryPrefixLength</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">The number of leading bits in the Prefix that are valid.</L-2>
                                                <L-2 L="ZH">概述：TcpIpNdpPrefixListEntryPrefixLength定义了在Neighbor Discovery Protocol（NDP）中使用的网络前缀的长度，用于IPv6地址的自动配置和网络地址的管理。</L-2>
                                                <L-2 L="ZH">注意：前缀长度应在1到128之间，以适应IPv6地址的结构；配置时需确保与网络实际使用的前缀长度一致，避免地址配置错误或冲突；在AUTOSAR CP 4.4标准中，此配置项的属性应与网络需求和设计相匹配，无特殊不一致事项。</L-2>
                                                <L-2 L="ZH">该配置项未使用</L-2>
                                              </DESC>
                                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00207</RELATED-TRACE-ITEM-REF>
                                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                              <SCOPE>LOCAL</SCOPE>
                                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                              <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                              </VALUE-CONFIG-CLASSES>
                                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                              <MAX>128</MAX>
                                              <MIN>0</MIN>
                                            </ECUC-INTEGER-PARAM-DEF>
                                            <ECUC-STRING-PARAM-DEF UUID="ECUC:fac2aaf6-93dc-44fe-b821-65ad70c83762">
                                              <SHORT-NAME>TcpIpNdpPrefixListEntryPrefixAddress</SHORT-NAME>
                                              <DESC>
                                                <L-2 L="EN">The prefix of an IP address. This prefix can be used for on-link determination.</L-2>
                                                <L-2 L="ZH">概述：TcpIpNdpPrefixListEntryPrefixAddress 配置项用于定义IPv6网络中的前缀地址，这个地址用于自动配置和地址解析过程中，它是Neighbor Discovery Protocol (NDP) 的一部分。</L-2>
                                                <L-2 L="ZH">注意：在配置IPv6地址时，必须确保前缀地址的格式正确且与网络设置相匹配；前缀长度通常是64位，但应根据具体网络要求进行设置；在AUTOSAR CP 4.4标准中，该配置项应与其他网络配置参数一起正确设置以确保网络通信的正确性。</L-2>
                                                <L-2 L="ZH">该配置项未使用</L-2>
                                              </DESC>
                                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00208</RELATED-TRACE-ITEM-REF>
                                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                              <SCOPE>LOCAL</SCOPE>
                                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                              <VALUE-CONFIG-CLASSES>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                              </VALUE-CONFIG-CLASSES>
                                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                              <ECUC-STRING-PARAM-DEF-VARIANTS>
                                                <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
                                              </ECUC-STRING-PARAM-DEF-VARIANTS>
                                            </ECUC-STRING-PARAM-DEF>
                                          </PARAMETERS>
                                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                                      </SUB-CONTAINERS>
                                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                                  </SUB-CONTAINERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:00b945e4-14b4-48c1-9e71-4b311d60535d">
                                  <SHORT-NAME>TcpIpNdpSlaacConfig</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Specifies the configuration parameters for StateLess Address AutoConfiguration.</L-2>
                                    <L-2 L="ZH">概述：TcpIpNdpSlaacConfig 是一个配置参数，用于定义TCP/IP协议栈中IPv6无状态地址自动配置（SLAAC）的相关属性，这包括地址生成、有效期和其他与SLAAC相关的配置。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpNdpSlaacConfig时，需要确保IPv6网络的正确性和地址的唯一性；此外，应当注意与网络硬件和操作系统的兼容性；根据AUTOSAR CP 4.4标准，还需确保配置项符合IPv6协议的规范要求。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00122</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <PARAMETERS>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:01a2dad0-39f2-4d0a-b60b-8e51fb4a8fea">
                                      <SHORT-NAME>TcpIpNdpSlaacDelayEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">If enabled transmission of the first DAD Neighbor Solicitation will be delayed by a random value from [0...MAX_DAD_DELAY].</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpSlaacDelayEnabled 是一个配置项，用于启用或禁用基于邻居发现协议（NDP）的无状态地址自动配置（SLAAC）的随机延迟机制，以减少网络上的冲突。</L-2>
                                        <L-2 L="ZH">注意：在配置此项时，应考虑网络的具体需求和行为；如果启用，需要确保随机延迟的时间范围符合网络性能要求；在某些实时性要求较高的系统中，可能需要禁用此功能以避免不确定的延迟。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">&quot;This serves to alleviate congestion when many nodes start up on the link at the same time, such as after a power failure, and may help to avoid race conditions when more than one node is trying to solicit for the same address at the same time.&quot;

                                                                        &quot;The delay will avoid similar congestion when multiple nodes are going to configure addresses by receiving the same single multicast router advertisement.&quot;

                                                                        [RFC4861 5.4.2. Sending Neighbor Solicitation Messages]

                                                                        Default: True</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00125</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5d672e0b-2b22-4e00-9da4-2b4941af4021">
                                      <SHORT-NAME>TcpIpNdpSlaacOptimisticDadEnabled</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Enable Optimistic Duplicate Address Detection (DAD) according to RFC4429.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpSlaacOptimisticDadEnabled 是一个配置选项，用于启用或禁用在使用无状态地址自动配置(SLAAC)时进行乐观的重复地址检测(DAD)过程。</L-2>
                                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，乐观的DAD是一个可选特性，它允许设备在地址验证过程还未完成时就开始使用该地址；这可能会提高网络接口的设置速度，但也可能增加地址冲突的风险；在配置此选项时，应当考虑网络的安全性和稳定性需求。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00126</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                    </ECUC-BOOLEAN-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:96784910-4551-4152-b291-cc795128df0b">
                                      <SHORT-NAME>TcpIpNdpSlaacDadRetransmissionDelay</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Sets the maximum value for the address configuration delay (s).</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpSlaacDadRetransmissionDelay 配置项用于指定在使用无状态地址自动配置(SLAAC)时，网络协议栈在发送重复地址检测(DAD)消息之间的等待时间。</L-2>
                                        <L-2 L="ZH">注意：该值应根据网络的具体条件和性能要求进行配置；过小的重传延迟可能导致网络拥塞，而过大的延迟可能导致配置过程不必要的延长；在配置此参数时，应遵循RFC 4861中关于DAD的建议和要求。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">According to [RFC4861 5.4.2. Sending Neighbor Solicitation Messages] this value should be the same as MAX_RTR_SOLICITATION_DELAY.

                                                                        Default: MAX_RTR_SOLICITATION_DELAY = 1 second</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00127</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">10</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:fab275fe-9879-4be5-9998-f83505ed02c6">
                                      <SHORT-NAME>TcpIpNdpSlaacDadNumberOfTransmissions</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Number of Neighbor Solicitations that have to be unanswered in order to set an autoconfigurated address to PREFERRED (usable) state.</L-2>
                                        <L-2 L="ZH">概述：TcpIpNdpSlaacDadNumberOfTransmissions配置项定义了在无状态地址自动配置(SLAAC)过程中，为验证IPv6地址的唯一性而发送的邻居发现协议(NDP)重复地址检测(DAD)消息的数量。</L-2>
                                        <L-2 L="ZH">注意：该值应根据网络的具体需求和性能考虑进行配置；设置过低可能导致地址冲突未被检测到，设置过高可能导致网络启动延迟；在AUTOSAR CP 4.4标准中，确保该配置与网络架构和协议栈的其他部分兼容。</L-2>
                                        <L-2 L="ZH">该配置项未使用</L-2>
                                      </DESC>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">[RFC4861 5.1. Node Configuration Variables]

                                                                        Default: DupAddrDetectTransmits = 1

                                                                        Setting this value to 0 turns off DAD.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00128</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                      <SCOPE>LOCAL</SCOPE>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                      <VALUE-CONFIG-CLASSES>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                        <ECUC-VALUE-CONFIGURATION-CLASS>
                                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                        </ECUC-VALUE-CONFIGURATION-CLASS>
                                      </VALUE-CONFIG-CLASSES>
                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                      <MAX>254</MAX>
                                      <MIN>0</MIN>
                                    </ECUC-INTEGER-PARAM-DEF>
                                  </PARAMETERS>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                              </SUB-CONTAINERS>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6a1a371d-f67b-4ed4-b32d-a387daefe276">
                      <SHORT-NAME>TcpIpLocalAddr</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the local IP (Internet Protocol) addresses used for IP communication.</L-2>
                        <L-2 L="ZH">概述：TcpIpLocalAddr配置项定义了TCP/IP协议栈中本地地址的配置信息，包括IP地址、子网掩码和默认网关等，用于网络通信中的地址分配和识别。</L-2>
                        <L-2 L="ZH">注意：在配置TcpIpLocalAddr时，必须确保IP地址的唯一性和正确性，避免网络冲突；子网掩码需要正确配置以确保网络分段的准确性；默认网关的配置应当指向可达的路由器地址，以保证外网通信的可行性。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00020</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <PARAMETERS>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:1d910e19-7798-400b-ac41-30faba0bd724">
                          <SHORT-NAME>TcpIpAddressType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Address type.</L-2>
                            <L-2 L="ZH">概述：TcpIpAddressType配置项用于定义TCP/IP模块中使用的IP地址类型，包括unicast，multicast，anycast，确保网络通信的正确性和兼容性。</L-2>
                            <L-2 L="ZH">注意：在配置TcpIpAddressType时，需要依据实际的通信场景选择正确的IP地址类型，unicast为单播通信，multicast为多播通信，anycast为任意地址通信；AUTOSAR CP 4.4标准中对IP地址类型的支持可能有特定要求或限制，需仔细参考相关文档。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00031</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:46f449c5-6bc6-9300-520a-9dbb67997a92">
                              <SHORT-NAME>TCPIP_ANYCAST</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:533a8795-c1f0-909c-402f-e853f0763d52">
                              <SHORT-NAME>TCPIP_MULTICAST</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b0d54950-124c-9d6c-6642-746b3dee6962">
                              <SHORT-NAME>TCPIP_UNICAST</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:c04becb0-738d-45f7-8cf6-f68c66ba96fe">
                          <SHORT-NAME>TcpIpDomainType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Address family.</L-2>
                            <L-2 L="ZH">概述：TcpIpDomainType配置项用于指定TCP/IP协议栈中使用的网络域类型，决定了网络通信的地址族，常见的类型包括IPv4和IPv6。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保选择的TcpIpDomainType与项目的网络需求一致；若项目需要同时支持IPv4和IPv6，则需要为每种协议配置独立的TcpIpDomainType；配置错误可能导致网络通信失败或性能下降。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">TCPIP_AF_INET</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00030</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6f89b0b5-90bd-98b4-61a7-673e6eaca81a">
                              <SHORT-NAME>TCPIP_AF_INET</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:7d959022-a735-9e96-5baf-e8b078d18ead">
                              <SHORT-NAME>TCPIP_AF_INET6</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:af637f56-8540-4c07-8659-48d3e365a0fc">
                          <SHORT-NAME>TcpIpAddrId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">IP address table identifier assigned by TCP/IP stack.</L-2>
                            <L-2 L="ZH">概述：TcpIpAddrId 是一个配置项，用于唯一标识网络栈中的IP地址，它关联了特定的IP地址配置和使用该地址的网络接口。</L-2>
                            <L-2 L="ZH">注意：在配置TcpIpAddrId时，必须确保每个ID在整个系统中是唯一的；此外，TcpIpAddrId的分配应与网络接口和IP地址配置保持一致；在配置过程中，还需注意与其他网络配置参数的依赖关系和兼容性。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00029</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>true</SYMBOLIC-NAME-VALUE>
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                      </PARAMETERS>
                      <REFERENCES>
                        <ECUC-REFERENCE-DEF UUID="ECUC:bbcaa5c1-c073-4ff8-984e-37facab72e21">
                          <SHORT-NAME>TcpIpCtrlRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to a TcpIpCtrl specifying the EthIf Controller where the IP address shall be assigned.</L-2>
                            <L-2 L="ZH">概述：TcpIpCtrlRef 是一个配置参数，用于指定 TCP/IP 协议栈控制器的引用，确保网络通信功能与特定的网络控制器相关联。</L-2>
                            <L-2 L="ZH">注意：在配置 TcpIpCtrlRef 时，必须确保引用的网络控制器与 TCP/IP 协议栈兼容；引用的控制器必须在系统中存在并被正确初始化；在多控制器系统中，每个 TCP/IP 堆栈应有其唯一的控制器引用。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00032</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/TcpIp/TcpIpConfig/TcpIpCtrl</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
                        <ECUC-REFERENCE-DEF UUID="ECUC:98fcf3a5-aa77-4dae-89d3-0a93dc4a447c">
                          <SHORT-NAME>TcpIpLocalAddrIPv6ExtHeaderFilterRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to a set of IPv6 Extension Headers which are allowed for this local IPv6 address.</L-2>
                            <L-2 L="ZH">概述：TcpIpLocalAddrIPv6ExtHeaderFilterRef 是一个配置项，用于引用IPv6扩展头过滤器的定义，该过滤器决定了哪些IPv6扩展头将被本地地址接受或忽略。</L-2>
                            <L-2 L="ZH">注意：在配置时需要确保引用的IPv6扩展头过滤器已经定义；此配置项对于IPv6通信至关重要，错误的配置可能导致通信问题；AUTOSAR CP 4.4标准中应当遵循相关的网络配置规范，以保证网络层的兼容性和正确性。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Note: this parameter is only relevant if the related TcpIpDomainType is TCPIP_AF_INET6.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00200</RELATED-TRACE-ITEM-REF>
