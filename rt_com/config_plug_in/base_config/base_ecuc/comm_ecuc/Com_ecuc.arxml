                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-FLOAT-PARAM-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComMainFunctionRx/MainRxTimeBase</DEFINITION-REF>
