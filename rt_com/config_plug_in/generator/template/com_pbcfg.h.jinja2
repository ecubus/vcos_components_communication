/* COM Tx IPDU IDs */
{%- for IPdu in ComConfig.ComTxIPdus_totle.keys() %}
    {%- set ipduObj = GetIPduObject(IPdu, ComConfig.ComTxIPdus_totle) %}
{{ "%-80s" | format("#define COM_PDU_ID_" ~ ipduObj.MessageName) }}({{ "%s" | format(ipduObj.message_id_trx ~ "U") }})
{%- endfor %}

/* COM Rx IPDU IDs */
