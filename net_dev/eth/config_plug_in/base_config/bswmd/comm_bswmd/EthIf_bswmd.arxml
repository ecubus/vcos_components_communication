                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:f6d7cd06-6712-4b97-9019-417f28773986">
                      <SHORT-NAME>EthIfGetAndResetMeasurementDataApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables / Disables the Get and Reset Measurement Data API</L-2>
                        <L-2 L="ZH">概述：EthIfGetAndResetMeasurementDataApi是一个配置项，用于启用或禁用以太网接口模块（EthIf模块）中的一个API，该API允许获取和重置网络接口的测量数据。</L-2>
                        <L-2 L="ZH">注意：在使用此API时，需要确保它与系统的诊断和性能监控需求相匹配；如果启用，必须实现相应的回调函数来处理获取的数据；在AUTOSAR CP 4.4标准中，此API的使用应当遵循以太网接口模块的规范。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00072</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
