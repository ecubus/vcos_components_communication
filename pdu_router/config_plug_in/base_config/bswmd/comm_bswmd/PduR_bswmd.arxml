                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:28bfa72a-3116-4c8d-a7be-f4fcbc364c52">
                          <SHORT-NAME>PduRDestPduLengthHandlingStrategy</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Pdu length handling strategy while destination Pdu lengh is langer than Pdu length in EcuC</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This parameter is only used for communication interface routings. It is ignored for transmport protocol routings.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_PduR_00289</RELATED-TRACE-ITEM-REF>
