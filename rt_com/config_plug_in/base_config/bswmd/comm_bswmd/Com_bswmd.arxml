                                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                      <MAX INTERVAL-TYPE="CLOSED">3600</MAX>
                                      <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                                    </ECUC-FLOAT-PARAM-DEF>
                                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:ce45c969-d5d9-d305-f36e-8e8a95353990">
                                      <SHORT-NAME>ComTxModeTimeOffset</SHORT-NAME>
                                      <DESC>
                                        <L-2 L="EN">Defines the period in seconds between the start of the I-PDU by Com_IpduGroupStart and the first transmission request in case ComTxModeMode is configured to PERIODIC or MIXED. In case of the mixed transmission mode only the periodic part is affected.</L-2>
                                      </DESC>
                                      <ADMIN-DATA>
                                        <SDGS>
                                          <SDG GID="VCOS:Display">
                                            <SD GID="VCOS:BaseUnit">s</SD>
                                          </SDG>
                                        </SDGS>
                                      </ADMIN-DATA>
                                      <INTRODUCTION>
                                        <P>
                                          <L-1 L="EN">In case ComTxModeTimeOffset is omitted or configured to 0, the first periodic transmission shall be transmitted within the next invocation of Com_MainFunctionTx.</L-1>
                                        </P>
                                      </INTRODUCTION>
                                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00180</RELATED-TRACE-ITEM-REF>
                                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
