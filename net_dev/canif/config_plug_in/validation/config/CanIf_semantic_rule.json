    "CANIF013002": {
        "rule_name": "CANIF013002",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of CanIfRxPduCanIdType and CanIfRxPduCanId.",
        "rule_message": "If CanIfRxPduCanIdType is STANDARD_CAN or STANDARD_FD_CAN, then CanIfRxPduCanId must >= 0 and <= 0x7ff. If CanIfRxPduCanIdType is EXTENDED_CAN or EXTENDED_FD_CAN, then CanIfRxPduCanId must >= 0 and <= 0x1ffffff",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanIdType",
                        "value_operator": "==",
                        "value": "STANDARD_CAN",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanIdType",
                        "value_operator": "==",
                        "value": "STANDARD_FD_CAN",
                        "logical_operator": "or"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanId",
                        "value_operator": ">=",
                        "value": "0",
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanId",
                        "value_operator": "<=",
                        "value": "0x7ff",
                        "logical_operator": "and"
                    }
                ]
            },
            "ruleset_02": {
                "base_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanIdType",
                        "value_operator": "==",
                        "value": "EXTENDED_CAN",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanIdType",
                        "value_operator": "==",
                        "value": "EXTENDED_FD_CAN",
                        "logical_operator": "or"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanId",
                        "value_operator": ">=",
                        "value": "0",
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/CanIf/CanIfInitCfg/CanIfRxPduCfg/CanIfRxPduCanId",
                        "value_operator": "<=",
                        "value": "0x1fffffff",
                        "logical_operator": "and"
                    }
                ]
            }
        },
        "auto_solve_list": [],
        "manual_solve_list": []
    },
