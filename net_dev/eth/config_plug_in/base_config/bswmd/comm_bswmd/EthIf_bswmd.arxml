                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:614ff812-60de-4304-a9e8-0ceabfcaef7d">
                      <SHORT-NAME>EthIfPortStartupActiveTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Denote the time delay after the mode &quot;ETHTRCV_MODE_ACTIVE&quot; of all EthIfSwitchPorts are requested via EthIf_StartAllPorts.</L-2>
                        <L-2 L="ZH">概述：EthIfPortStartupActiveTime 配置项定义了以太网接口在启动时的活跃时间，这是接口在能够正常传输数据之前必须保持活跃的最小时间。</L-2>
                        <L-2 L="ZH">注意：此参数的设置应考虑网络的启动时间和稳定性需求；过短的活跃时间可能导致网络连接不稳定；此配置项应与网络硬件和驱动程序的规格相匹配。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:Display">
                            <SD GID="VCOS:BaseUnit">s</SD>
                          </SDG>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">This is only used for ports in EthIfSwtPortGroups which are not referenced by any EthIfController.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00055</RELATED-TRACE-ITEM-REF>
