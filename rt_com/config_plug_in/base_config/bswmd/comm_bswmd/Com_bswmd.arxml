                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:f3e4a642-5230-8fe3-6138-5a8352d43de7">
                          <SHORT-NAME>ComHandleId</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The numerical value used as the ID.</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This ID identifies signals and signal groups in the COM APIs using Com_SignalIdType or Com_SignalGroupIdType parameter respectively.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00165</RELATED-TRACE-ITEM-REF>
