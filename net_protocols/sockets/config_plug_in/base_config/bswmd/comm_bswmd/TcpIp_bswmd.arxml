                            <ECUC-STRING-PARAM-DEF UUID="ECUC:60dacd09-abc5-46d1-9f94-7e190631cfac">
                              <SHORT-NAME>TcpIpSocketOwnerTxConfirmationName</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This parameter defines the name of the &lt;Up_TxConfirmation&gt; function of the TcpIpSocketOwner module. The function name shall only be configurable if TcpIpSocketOwnerUpperLayerType is set to CDD.</L-2>
                                <L-2 L="ZH">概述：TcpIpSocketOwnerTxConfirmationName 是一个配置参数，用于指定在TCP/IP协议栈中，当数据成功发送后，哪个Socket所有者（如某个应用层模块）将被通知确认信息。</L-2>
                                <L-2 L="ZH">注意：在配置时需确保该名称与系统中定义的Socket所有者名称一致；此参数通常与TcpIpSocketOwner配置项相关联，需要与其保持一致性；在配置多个Socket所有者时，每个Socket所有者的确认函数名称应该是唯一的，以避免潜在的冲突。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00177</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <SCOPE>LOCAL</SCOPE>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                              <VALUE-CONFIG-CLASSES>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                                <ECUC-VALUE-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-VALUE-CONFIGURATION-CLASS>
                              </VALUE-CONFIG-CLASSES>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <ECUC-STRING-PARAM-DEF-VARIANTS>
                                <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
                              </ECUC-STRING-PARAM-DEF-VARIANTS>
                            </ECUC-STRING-PARAM-DEF>
                          </PARAMETERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:b6d17e9f-4cd1-4f2f-ab59-848c8358a711">
                      <SHORT-NAME>TcpIpTcpConfig</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the configuration parameters of the TCP (Transmission Control Protocol) sub-module.</L-2>
                        <L-2 L="ZH">概述：TcpIpTcpConfig 是用于配置TCP/IP协议栈中TCP协议相关参数的配置项，它包括了如超时时间、最大重传次数等TCP连接的参数设置。</L-2>
                        <L-2 L="ZH">注意：在配置TcpIpTcpConfig时，需要确保参数设置符合网络通信的性能要求和稳定性需求；参数值应当遵循AUTOSAR CP 4.4标准中对TCP参数的规定，以保证兼容性和系统的可靠性；过于激进或保守的参数设置可能会影响通信效率或造成网络拥塞。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00025</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:377ac636-7c43-4a6c-b08e-2a0e95ef4138">
                          <SHORT-NAME>TcpIpTcpCongestionAvoidanceEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of TCP congestion avoidance algorithm according to IETF RFC 5681.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpCongestionAvoidanceEnabled 配置项用于启用或禁用TCP/IP协议栈中的拥塞避免机制，该机制负责在网络拥塞时调整数据传输速率。</L-2>
                            <L-2 L="ZH">注意：在配置此项时，需考虑网络的实际条件和性能要求；不正确的配置可能导致网络拥塞控制不当，影响通信效率；AUTOSAR CP 4.4标准中应确保该配置与系统需求和其他网络配置参数协同工作。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00061</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:d9d2b132-c519-4e77-87a9-f7fe266a3d20">
                          <SHORT-NAME>TcpIpTcpFastRecoveryEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of TCP Fast Recovery according to IETF RFC 5681.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpFastRecoveryEnabled 是一个配置参数，用于启用或禁用TCP快速恢复机制，该机制在TCP发生丢包时帮助快速恢复连接的稳定性和性能。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与网络堆栈的其他部分和TCP协议的实现细节保持一致；考虑到系统资源和性能要求，合理启用或禁用此功能；在配置时应注意与TcpIpTcpFastRetransmitEnabled配置项的关系和协同工作。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00063</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b6294231-685a-4bd8-8021-f7b479bee325">
                          <SHORT-NAME>TcpIpTcpFastRetransmitEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of TCP Fast Retransmission according to IETF RFC 5681.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpFastRetransmitEnabled配置项用于启用或禁用TCP快速重传机制，这是一种网络通信性能优化手段，旨在快速恢复丢失的数据包。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保网络管理策略与此配置项相协调，以优化网络性能；不当的启用或禁用可能导致网络延迟增加或通信不稳定；此配置项对实时数据传输尤为关键，需根据应用需求谨慎配置。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00062</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:e1ca1ec7-6c47-45dd-9dd5-3b67d759c681">
                          <SHORT-NAME>TcpIpTcpKeepAliveEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) TCP Keep Alive Probes according to IETF RFC 1122 chapter 4.2.3.6</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpKeepAliveEnabled 配置项用于启用或禁用TCP连接的Keep Alive机制，该机制可以定期检查TCP连接是否仍然有效，以维持长时间的连接。</L-2>
                            <L-2 L="ZH">注意：在配置该项时，需考虑系统对网络连接稳定性的要求；过于频繁的Keep Alive消息可能会增加网络负载；不正确的配置可能导致资源浪费或连接不稳定。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00082</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:5c527c7e-097e-4f58-8d42-7221665b49a1">
                          <SHORT-NAME>TcpIpTcpNagleEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of Nagle's algorithm according to IETF RFC 896. If enabled the Nagle's algorithm is activated per default for all TCP sockets, but can be deactivated via TcpIp_ChangeParameter() API.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpNagleEnabled配置项用于启用或禁用TCP/IP协议栈中的Nagle算法，该算法旨在减少网络上的小分组数量，通过合并小的TCP数据包来提高网络效率。</L-2>
                            <L-2 L="ZH">注意：在实时性要求较高的应用中应谨慎启用Nagle算法，因为它可能增加数据的传输延迟；此配置项的默认值依赖于具体的AUTOSAR TCP/IP协议栈实现，需查阅具体实现文档确认；在配置此项时，应考虑网络带宽和延迟的权衡。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00059</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8a65daaf-f62f-43ad-af6a-b9029d48d4f2">
                          <SHORT-NAME>TcpIpTcpSlowStartEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of TCP slow start algorithm according to IETF RFC 5681.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpSlowStartEnabled 是一个配置参数，用于启用或禁用TCP协议中的慢启动算法，该算法用于控制数据传输的拥塞窗口的增长速度，以避免网络拥塞。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与网络的拥塞控制策略一致；不当的启用或禁用可能会影响网络性能和稳定性；在配置时应考虑网络的实际条件和性能要求。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00060</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:2f497c46-1e1e-4489-92c7-954bc7e0e3e9">
                          <SHORT-NAME>TcpIpTcpFinWait2Timeout</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout in [s] to receive a FIN from the remote node (after this node has initiated connection termination), i.e. maximum time waiting in FINWAIT-2 for a connection termination request from the remote TCP.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpFinWait2Timeout 配置项用于定义在TCP/IP协议栈中，TCP连接在FIN-WAIT-2状态下等待对方的FIN包的超时时间。</L-2>
                            <L-2 L="ZH">注意：该值需要根据网络条件和应用需求谨慎配置，以避免过早关闭连接或资源占用过长；超时设置不当可能会导致网络连接问题，如连接挂起或资源泄露；在AUTOSAR CP 4.4标准中，确保该配置项的数值符合系统的实时性和可靠性要求。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00066</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:77bfdfab-c379-4841-bd2a-1bf4222d8a74">
                          <SHORT-NAME>TcpIpTcpKeepAliveInterval</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the interval in [s] between subsequent keepalive probes.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpKeepAliveInterval 配置项用于定义TCP连接在没有数据传输时发送保活（Keep-Alive）探测包的时间间隔，以维持连接的活跃状态。</L-2>
                            <L-2 L="ZH">注意：该值应根据网络条件和应用需求谨慎配置，避免过于频繁的保活探测导致不必要的网络负载；保持与系统的其他超时设置（如Nagle算法的延迟确认时间）的协调一致；在配置时需确保符合AUTOSAR CP 4.4标准中对于TCP保活机制的规定。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00070</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:96a8eaff-2374-41ea-a93a-51d4fb2543fd">
                          <SHORT-NAME>TcpIpTcpKeepAliveTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Specifies the time in [s] between the last data packet sent (simple ACKs are not considered data) and the first keepalive probe. Note: Setting this configuration parameter to a value smaller or equal to the value of TcpIpMainFunctionPeriod results in the transmission of keep alive probes within every MainFunction cycle.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpKeepAliveTime配置项用于定义TCP连接在没有数据传输时，保持连接活跃的时间间隔，即在此时间后发送keepalive探测包以检测连接是否仍然有效。</L-2>
                            <L-2 L="ZH">注意：该值的设置需要根据网络条件和应用需求谨慎选择，以避免过频繁的探测导致不必要的网络负担；过长的时间间隔可能导致无效连接长时间占用资源；AUTOSAR CP 4.4标准中对此参数的具体推荐值或范围没有明确规定，需要参考具体的网络协议栈实现和应用场景。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00087</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>7200</DEFAULT-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:491c9101-a4f8-4a8e-a81e-791c141f78f1">
                          <SHORT-NAME>TcpIpTcpMsl</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maximum segment lifetime in [s].</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpMsl配置项定义了TCP/IP协议栈中的最大段生命周期（Maximum Segment Lifetime），它是TCP连接被终止后，该连接的任何数据包在网络中存在的最长时间。</L-2>
                            <L-2 L="ZH">注意：该值的设置对系统资源和网络性能有重要影响；过小的值可能导致有效数据包被过早丢弃，过大的值可能导致资源占用过久；在AUTOSAR CP 4.4标准中，确保该配置项与网络的实际条件和应用需求相匹配。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">(Note: TIME-WAIT = 2 x TcpIpTcpMsl - to ensure that the remote node received the acknowledgment to its connection termination request.)</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00067</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:a90fd0df-b01a-4fac-8a08-2fcca147dcfd">
                          <SHORT-NAME>TcpIpTcpRetransmissionTimeout</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout in [s] before an unacknowledged TCP segment is sent again.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpRetransmissionTimeout 配置项用于定义TCP协议栈中，当一个TCP段需要重传时，等待重传的超时时间。</L-2>
                            <L-2 L="ZH">注意：该值需要根据网络的具体条件和性能要求来调整，以确保网络通信的可靠性和效率；设置过短可能导致不必要的网络流量和性能问题，设置过长可能导致应用响应延迟；在AUTOSAR CP 4.4标准中，该配置项的合理取值范围和默认值应参考相关的TCP/IP协议栈模块规范。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">If the timeout is disabled or set to INF, no TCP segments shall be retransmitted.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00068</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:10a71105-c926-4334-956a-37209d582f80">
                          <SHORT-NAME>TcpIpTcpSynReceivedTimeout</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Timeout in [s] to complete a remotely initiated TCP connection establishment, i.e. maximum time waiting in SYN-RECEIVED for a confirming connection request acknowledgment after having both received and sent a connection request.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpSynReceivedTimeout 配置项用于定义TCP/IP协议栈中，等待一个SYN+ACK响应的最大时间，在这个时间内如果没有收到响应，连接请求将被终止。</L-2>
                            <L-2 L="ZH">注意：该值需要根据网络的延迟和拥塞情况来合理设置，以避免过早断开可能成功的连接；过高的值可能导致资源占用时间过长，影响系统性能；该参数的设置应遵循AUTOSAR CP 4.4标准中对于TCP连接建立的相关规定。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00065</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX INTERVAL-TYPE="CLOSED">Inf</MAX>
                          <MIN INTERVAL-TYPE="CLOSED">0</MIN>
                        </ECUC-FLOAT-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:cc9b33ac-f00a-4810-ac17-eb37b87d9cde">
                          <SHORT-NAME>TcpIpTcpKeepAliveProbesMax</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maximum number of times that a TCP Keep Alive is retransmitted before the connection is closed.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpKeepAliveProbesMax配置项定义了在TCP连接中，当没有数据交换时，最大的保活探测报文发送次数，用于维持连接的活性。</L-2>
                            <L-2 L="ZH">注意：该值应当根据网络条件和应用需求谨慎设置，以避免过早断开连接或资源浪费；超出此次数未收到响应则认为连接已断开；AUTOSAR CP 4.4标准中未明确指定默认值，需参考具体的网络堆栈实现。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00071</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <MAX>65535</MAX>
                          <MIN>0</MIN>
                        </ECUC-INTEGER-PARAM-DEF>
                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2945d466-c5a3-423d-b359-5f8226e85e79">
                          <SHORT-NAME>TcpIpTcpMaxRtx</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Maximum number of times that a TCP segment is retransmitted before the TCP connection is closed. This parameter is only valid if TcpIpTcpRetransmissionTimeout is configured.</L-2>
                            <L-2 L="ZH">概述：TcpIpTcpMaxRtx 配置项用于定义TCP协议中最大重传次数，即一个TCP报文段在被认定为丢失之前，可以被重传的最大次数。</L-2>
                            <L-2 L="ZH">注意：该值应当根据网络条件和应用场景谨慎设置，以避免过早放弃重传导致的连接失败，或者过多重传导致的网络资源浪费；在AUTOSAR CP 4.4标准中，该配置项的取值范围应符合标准规定，否则可能会导致不兼容或性能问题；在配置时还需考虑与TcpIpTcpRto和TcpIpTcpSynMaxRtx等参数的关系和整体网络栈的性能优化。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Note: This parameter also applies for FIN retransmissions.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00069</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
