                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>CANNM_PDU_BYTE_0</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:4cc3bb28-05fb-8a23-33e2-fa1e07553cac">
                              <SHORT-NAME>CANNM_PDU_BYTE_0</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3535fbdc-9e7e-870e-5915-45ae4613cf1d">
                              <SHORT-NAME>CANNM_PDU_BYTE_1</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:204ad79c-62dc-8cd6-606e-a2685285c069">
                              <SHORT-NAME>CANNM_PDU_OFF</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:4d249c1c-3176-4ea0-93eb-07d16128346d">
                          <SHORT-NAME>CanNmImmediateNmCycleTime</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines the immediate NM PDU cycle time in seconds which is used for CanNmImmediateNmTransmissions NM PDU transmissions.</L-2>
                            <L-2 L="ZH">概述：CanNmImmediateNmCycleTime定义了在CAN网络管理中，立即网络管理周期的时间间隔，用于控制在特定条件下发送即时NM消息的频率。</L-2>
                            <L-2 L="ZH">注意：该时间值应小于或等于CanNmMainFunctionPeriod，以确保即时NM消息能够按预期频率发送；配置值应考虑网络负载和性能要求，避免对网络造成过大压力；在AUTOSAR CP 4.4标准中，该配置项的单位通常是毫秒（ms），确保单位的一致性。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00057</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
