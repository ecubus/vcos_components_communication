                        <ECUC-STRING-PARAM-DEF-CONDITIONAL>
                          <MAX-LENGTH>32</MAX-LENGTH>
                          <MIN-LENGTH>1</MIN-LENGTH>
                        </ECUC-STRING-PARAM-DEF-CONDITIONAL>
                      </ECUC-STRING-PARAM-DEF-VARIANTS>
                    </ECUC-STRING-PARAM-DEF>
                    <ECUC-FUNCTION-NAME-DEF UUID="ECUC:27d3d6de-8a26-4a13-b89d-5ea56f75ec7e">
                      <SHORT-NAME>EthIfEthSetCorrectionTimeApi</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This parameter defines the existence and the name of a callout function for adjusting the local ETH Reference clock in HW. </L-2>
                        <L-2 L="ZH">概述：EthIfEthSetCorrectionTimeApi配置项用于启用或禁用以太网接口(EthIf)模块中的校正时间API，该API允许调整和同步以太网控制器的时间戳。</L-2>
                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保该API的使用与以太网控制器的硬件支持和时间敏感网络需求相匹配；如果不需要时间同步功能，可以禁用此API以节省资源；在配置时应考虑与其他网络管理功能的兼容性。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                            <SD GID="VCOS:CfgValue"></SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">This parameter defines the existence and the name of a callout function for adjusting the local ETH Reference clock in HW. </L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00666</RELATED-TRACE-ITEM-REF>
