            <AR-PACKAGE UUID="2745c651-f750-44ae-9b44-818ea27fa605">
              <SHORT-NAME>BswModuleDescriptions</SHORT-NAME>
              <ELEMENTS>
                <BSW-MODULE-DESCRIPTION UUID="4afeb230-20cc-4eb8-b768-1a74bb16b53f">
                  <SHORT-NAME>PduR</SHORT-NAME>
                  <PROVIDED-ENTRYS>
                    <BSW-MODULE-ENTRY-REF-CONDITIONAL>
                      <BSW-MODULE-ENTRY-REF DEST="BSW-MODULE-ENTRY">/AUTOSAR/PduR_ib_bswmd/BswModuleDescriptions/PduR_MainFunction</BSW-MODULE-ENTRY-REF>
                    </BSW-MODULE-ENTRY-REF-CONDITIONAL>
                  </PROVIDED-ENTRYS>
                  <INTERNAL-BEHAVIORS>
                    <BSW-INTERNAL-BEHAVIOR UUID="7ea2dd3e-6788-44b7-9833-ceeaa4d26420">
                      <SHORT-NAME>PduRBehavior</SHORT-NAME>
                      <EXCLUSIVE-AREAS>
                        <EXCLUSIVE-AREA UUID="64d88e68-2415-4812-af0d-9b94da0d1255">
                          <SHORT-NAME>PDUR_EXCLUSIVE_AREA_0</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">This exclusive area shall disable all wake up interrupts to prevent overwriting of some global variables.</L-2>
                          </DESC>
                        </EXCLUSIVE-AREA>
                        <EXCLUSIVE-AREA UUID="ca944f8b-fd43-482b-847b-e78f0088724f">
                          <SHORT-NAME>PDUR_EXCLUSIVE_AREA_1</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">This exclusive area is only used in case of multi core and if the the PduR is configured to handle also the slave cores. It must be configured as a spinlock to allow access to some variables simultaneously from multiple cores.</L-2>
                          </DESC>
                        </EXCLUSIVE-AREA>
                        <EXCLUSIVE-AREA UUID="ddf23415-103d-49c1-9fd3-ab62bdda96b8">
                          <SHORT-NAME>PDUR_EXCLUSIVE_AREA_2</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">This exclusive area is used for accessing the clock variable. It shall disable GPT interrupts and task changes. Only necessary if 32 Bit access is not atomic and Alarm Clock is present.</L-2>
                          </DESC>
                        </EXCLUSIVE-AREA>
                        <EXCLUSIVE-AREA UUID="113a8ee9-c816-481f-bc1f-3c38b10854d8">
                          <SHORT-NAME>PDUR_EXCLUSIVE_AREA_3</SHORT-NAME>
                          <DESC>
                            <L-2 L="FOR-ALL">This This exclusive area must be configured as a spin lock to protect access on global shutdown target variables.</L-2>
                          </DESC>
                        </EXCLUSIVE-AREA>
                      </EXCLUSIVE-AREAS>
                      <ENTITYS>
                        <BSW-SCHEDULABLE-ENTITY UUID="a3a7b60c-9557-4420-8644-efcaa1ce454b">
                          <SHORT-NAME>PduR_MainFunction</SHORT-NAME>
                          <IMPLEMENTED-ENTRY-REF DEST="BSW-MODULE-ENTRY">/AUTOSAR/PduR_ib_bswmd/BswModuleDescriptions/PduR_MainFunction</IMPLEMENTED-ENTRY-REF>
                        </BSW-SCHEDULABLE-ENTITY>
                      </ENTITYS>
                      <EVENTS>
                        <BSW-TIMING-EVENT UUID="de92c321-f30b-422e-bcfa-c96e3950c93c">
                          <SHORT-NAME>PduR_MainFunctionTimingEvent0</SHORT-NAME>
                          <STARTS-ON-EVENT-REF DEST="BSW-SCHEDULABLE-ENTITY">/AUTOSAR/PduR_ib_bswmd/BswModuleDescriptions/PduR/PduRBehavior/PduR_MainFunction</STARTS-ON-EVENT-REF>
                          <PERIOD>0.001</PERIOD>
                        </BSW-TIMING-EVENT>
                        <BSW-TIMING-EVENT UUID="ef55ed0a-481e-4b9b-a1df-d0558853c551">
                          <SHORT-NAME>PduR_MainFunctionTimingEvent1</SHORT-NAME>
                          <STARTS-ON-EVENT-REF DEST="BSW-SCHEDULABLE-ENTITY">/AUTOSAR/PduR_ib_bswmd/BswModuleDescriptions/PduR/PduRBehavior/PduR_MainFunction</STARTS-ON-EVENT-REF>
                          <PERIOD>0.001</PERIOD>
                        </BSW-TIMING-EVENT>
                        <BSW-TIMING-EVENT UUID="044f1d15-951d-4b4a-a8f9-a09bffac3418">
                          <SHORT-NAME>PduR_MainFunctionTimingEvent2</SHORT-NAME>
                          <STARTS-ON-EVENT-REF DEST="BSW-SCHEDULABLE-ENTITY">/AUTOSAR/PduR_ib_bswmd/BswModuleDescriptions/PduR/PduRBehavior/PduR_MainFunction</STARTS-ON-EVENT-REF>
                          <PERIOD>0.001</PERIOD>
                        </BSW-TIMING-EVENT>
                      </EVENTS>
                    </BSW-INTERNAL-BEHAVIOR>
                  </INTERNAL-BEHAVIORS>
                </BSW-MODULE-DESCRIPTION>
                <BSW-MODULE-ENTRY UUID="eba87248-2493-44bf-aa27-f9a686fb89da">
                  <SHORT-NAME>PduR_MainFunction</SHORT-NAME>
                  <CALL-TYPE>SCHEDULED</CALL-TYPE>
                  <EXECUTION-CONTEXT>TASK</EXECUTION-CONTEXT>
                </BSW-MODULE-ENTRY>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
