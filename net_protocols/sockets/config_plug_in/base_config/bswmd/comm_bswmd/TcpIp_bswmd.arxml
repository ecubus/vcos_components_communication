                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f419acb7-79f7-8f44-5fd8-9c021aff6ba4">
                          <SHORT-NAME>SC3</SHORT-NAME>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:028a71e1-7c9c-4f15-a045-d9aae98c1c22">
                      <SHORT-NAME>TcpIpMainFunctionPeriod</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Period of TcpIp_MainFunction in [s].</L-2>
                        <L-2 L="ZH">概述：TcpIpMainFunctionPeriod 配置项用于指定 TCP/IP 协议栈主函数的调用周期，这个周期决定了网络管理、通信控制和时间依赖性功能的处理频率。</L-2>
                        <L-2 L="ZH">注意：该值应当与系统定时器和任务调度策略相匹配，以确保网络性能和响应时间满足应用需求；过小的周期可能导致CPU负载过高，而过大的周期可能影响网络通信的实时性；在配置时应参照AUTOSAR CP标准中对于网络管理和通信控制相关的时间参数要求。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:Display">
                            <SD GID="VCOS:BaseUnit">s</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00013</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX INTERVAL-TYPE="OPEN">Inf</MAX>
                      <MIN INTERVAL-TYPE="OPEN">0</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:7633dda5-95ff-4d10-90e1-b14c8d44a498">
                      <SHORT-NAME>TcpIpTcpSocketMax</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maximum number of TCP sockets</L-2>
                        <L-2 L="ZH">概述：TcpIpTcpSocketMax 配置项定义了系统中可用的最大TCP套接字数量，这个值限制了同时可以建立的TCP连接的最大数目。</L-2>
                        <L-2 L="ZH">注意：该值应足够大以支持应用程序的并发连接需求；过小的值可能导致无法建立新的TCP连接；过大的值可能会浪费系统资源，因为每个套接字都会占用一定的内存。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00014</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:586351c4-1c51-403a-9ff9-d8b021d64753">
                      <SHORT-NAME>TcpIpUdpSocketMax</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maximum number of UDP sockets.</L-2>
                        <L-2 L="ZH">概述：TcpIpUdpSocketMax定义了系统中可用的最大UDP套接字数量，这个参数直接影响到UDP通信的并发能力。</L-2>
                        <L-2 L="ZH">注意：在配置TcpIpUdpSocketMax时，需要考虑系统的内存限制和UDP通信的需求量；过高的配置可能会浪费系统资源，过低则可能导致无法建立更多的UDP连接；该参数的配置应与AUTOSAR CP 4.4标准一致，确保系统的兼容性和稳定性。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00015</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                      </VALUE-CONFIG-CLASSES>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <MAX>65535</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                  <SUB-CONTAINERS>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a0e366b2-c4ba-4605-9d0f-07c9ff786299">
                      <SHORT-NAME>TcpIpIpV4General</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This container is a subcontainer of TcpIp and specifies the general configuration parameters of the TCP/IP stack for IPv4</L-2>
                        <L-2 L="ZH">概述：TcpIpIpV4General配置项用于定义TCP/IP协议栈中IPv4相关的通用配置，包括启用IPv4支持、配置默认的TTL(Time To Live)值等。</L-2>
                        <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保IPv4和IPv6的配置不冲突；正确设置TTL值以避免数据包在网络中无限循环；如果项目不使用IPv4，可以禁用以节省资源。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00163</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:1c68cff7-5b82-46bc-b28c-178e0899ef1b">
                          <SHORT-NAME>TcpIpArpEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of ARP (Address Resolution Protocol).</L-2>
                            <L-2 L="ZH">概述：TcpIpArpEnabled配置项用于启用或禁用TCP/IP协议栈中的地址解析协议（ARP）功能，这是决定系统是否支持通过ARP解析网络层地址到链路层地址的关键配置。</L-2>
                            <L-2 L="ZH">注意：在不需要局域网通信或者使用静态IP地址配置的场景下，可以考虑禁用ARP以节省资源；确保在启用ARP时，网络配置正确以避免潜在的地址冲突；AUTOSAR CP 4.4标准支持此配置，但实现细节可能因AUTOSAR软件供应商而异。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00006</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:b8bbc7c1-4759-4db6-b60f-2268e410f54b">
                          <SHORT-NAME>TcpIpIcmpEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disabled (FALSE) support of ICMP (Internet Control Message Protocol).</L-2>
                            <L-2 L="ZH">概述：TcpIpIcmpEnabled 配置项用于启用或禁用传输控制协议/互联网协议(TCP/IP)栈中的互联网控制消息协议(ICMP)支持，这对于网络错误诊断和消息控制是重要的。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保此配置项与系统的安全和诊断需求相符；不当的ICMP配置可能会导致安全风险；在资源受限的系统中，启用ICMP可能会影响系统性能。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00007</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:4b0954de-c16f-47d3-a9db-eba8a0f58eee">
                          <SHORT-NAME>TcpIpIpV4Enabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) support of IPv4 (Internet Protocol version 4).</L-2>
                            <L-2 L="ZH">概述：TcpIpIpV4Enabled 配置项用于启用或禁用TCP/IP协议栈中IPv4协议的支持，决定了系统是否能够处理IPv4网络通信。</L-2>
                            <L-2 L="ZH">注意：在不需要IPv4支持的系统中可以禁用以节省资源；如果系统需要同时支持IPv4和IPv6，则应确保同时启用TcpIpIpV4Enabled和TcpIpIpV6Enabled；配置更改可能需要重新编译和测试以确保网络功能的正确性。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00088</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:6f20049d-efe5-4b46-aaab-7e6b480c2d9e">
                          <SHORT-NAME>TcpIpPathMtuDiscoveryEnabled</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Enables (TRUE) or disables (FALSE) the discovery of the maximum transmission unit on a path according to IETF RfC 1191.</L-2>
                            <L-2 L="ZH">概述：TcpIpPathMtuDiscoveryEnabled配置项用于启用或禁用TCP/IP协议栈中的路径最大传输单元（Path MTU）发现机制，该机制允许网络设备发现并使用最有效的数据包大小，以避免在网络路径中的分片。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4标准中，确保网络配置与实际网络环境相匹配，以免导致数据传输效率低下或通信失败；过大的MTU值可能导致数据包在网络中被分片，影响性能；过小的MTU值可能导致利用率低下。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00012</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
