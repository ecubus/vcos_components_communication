                                      <SHORT-NAME>TRIGGERED</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:993058a1-3a8e-d253-e760-87abcf44b861">
                                      <SHORT-NAME>TRIGGERED_ON_CHANGE</SHORT-NAME>
