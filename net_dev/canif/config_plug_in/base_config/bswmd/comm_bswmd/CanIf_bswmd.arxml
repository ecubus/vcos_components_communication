                              <MAX-LENGTH>32</MAX-LENGTH>
                              <MIN-LENGTH>1</MIN-LENGTH>
                            </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
                          </ECUC-FUNCTION-NAME-DEF-VARIANTS>
                        </ECUC-FUNCTION-NAME-DEF>
                        <ECUC-FUNCTION-NAME-DEF UUID="ECUC:15d97844-3e67-4d9c-954e-4a9d5f077bc4">
                          <SHORT-NAME>CanIfRxPduUserRxCalloutName</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the name of the &lt;User_RxCalloutName&gt;.</L-2>
                            <L-2 L="ZH">概述：CanIfRxPduUserRxCalloutName 配置项指定了接收到特定CAN接口消息后调用的用户定义函数的名称。</L-2>
                            <L-2 L="ZH">注意：确保指定的函数名在项目中存在且已正确实现；函数应能处理从CAN接收的数据；在AUTOSAR CP 4.4中，此配置项的使用应符合接口模块的规范要求。</L-2>
                          </DESC>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">This parameter independs on the parameter CanIfRxPduUserRxIndicationUL.
                                                </L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanIf_00530</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
