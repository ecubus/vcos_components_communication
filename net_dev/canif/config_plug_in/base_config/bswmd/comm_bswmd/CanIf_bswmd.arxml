                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:a69ada24-f385-4751-96cd-05dd1b848ef5">
                                  <SHORT-NAME>CanIfHrhRangeRxPduUpperCanId</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Upper CAN Identifier of a receive CAN L-PDU for identifier range definition, in which all CAN Ids shall pass the software filtering.</L-2>
                                    <L-2 L="ZH">概述：CanIfHrhRangeRxPduUpperCanId用于定义接收PDU的CAN ID的上限值，用于配置接收消息ID范围的上界，以便过滤接收的CAN消息。</L-2>
                                    <L-2 L="ZH">注意：该配置项与CanIfHrhRangeRxPduLowerCanId配合使用，以定义一个接收消息ID的范围；确保UpperCanId大于或等于LowerCanId，避免配置错误；在配置ID范围时，考虑CAN网络上的消息ID分布，以优化消息过滤效率。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanIf_00630</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
