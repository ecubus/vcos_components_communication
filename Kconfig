config ETH_STACK
    bool "eth stack support"
    select SIM_ETH_DRIVER if ARCH_SIM
    default n
	---help---
		Enable the ETH_STACK

config MODULE_ETHIF
    bool "module EthIf support"
    default n
    ---help---
        Enable the module EthIf

config MODULE_TCPIP
    bool "module TcpIp support"
    default n
    ---help---
        Enable the module TcpIp