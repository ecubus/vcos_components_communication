                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:c8da15d1-4bf9-4d08-b710-afe890855205">
                      <SHORT-NAME>EthIfWakeUpSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Configures if wakeup is supported or not.</L-2>
                        <L-2 L="ZH">概述：EthIfWakeUpSupport配置项用于指定以太网接口（Ethernet Interface）是否支持唤醒功能，这使得网络接口能够在接收到特定的网络唤醒信号时唤醒系统。</L-2>
                        <L-2 L="ZH">注意：在配置EthIfWakeUpSupport时，需要确保硬件和底层驱动支持唤醒功能；此配置项对于实现低功耗网络通信场景至关重要；在AUTOSAR CP 4.4标准中，确保与网络管理需求和策略一致。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00040</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-VALUE-CONFIGURATION-CLASS>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
