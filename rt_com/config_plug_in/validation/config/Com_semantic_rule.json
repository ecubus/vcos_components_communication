{
    "COM013005": {
        "rule_name": "COM013005",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of Uint8_NFifoSize and Uint8_NFifoDepth.",
        "rule_message": "Uint8_NFifoSize and Uint8_NFifoDepth must both > 0 or == 0.",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoSize",
                        "value_operator": ">",
                        "value": "0",
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoDepth",
                        "value_operator": ">",
                        "value": "0",
                        "logical_operator": "and"
                    }
                ]
            },
            "ruleset_02": {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoDepth",
                        "value_operator": ">",
                        "value": "0",
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoSize",
                        "value_operator": ">",
                        "value": "0",
                        "logical_operator": "and"
                    }
                ]
            }
        },
        "auto_solve_list": [],
        "manual_solve_list": []
    },
    "COM013006": {
        "rule_name": "COM013006",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of ComSupportedTxSignalProx and FifoDepth configurations.",
        "rule_message": "ComSupportedTxSignalProx is true,so at least one of the FifoDepth configurations must > 0.Uint8_NFifoSize must > 4",
        "rule_ruleset": {
            "ruleset_01": {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/ComSupportedTxSignalProx",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8FifoDepth",
                        "value_operator": "!=",
                        "value": "0",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint16FifoDepth",
                        "value_operator": "!=",
                        "value": "0",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint32FifoDepth",
                        "value_operator": "!=",
                        "value": "0",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoSize",
                        "value_operator": "!=",
                        "value": "0",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoDepth",
                        "value_operator": "!=",
                        "value": "0",
                        "logical_operator": "or"
                    }
                ]
            }
        },
        "auto_solve_list": [],
        "manual_solve_list": []
    },
    "COM013007": {
        "rule_name": "COM013007",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of Uint8_NFifoSize configurations",
        "rule_message": "If use Uint8_N Fifo, this fifo size > uint32 Fifo, so Uint8_NFifoSize must > 4",
        "rule_ruleset": {
            "ruleset_01":
            {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/ComSupportedTxSignalProx",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoDepth",
                        "value_operator": ">",
                        "value": "0",
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComTxSignalFifo/Uint8_NFifoSize",
                        "value_operator": ">",
                        "value": "4",
                        "logical_operator": "and"
                    }
                ]
            }
        },
        "auto_solve_list": [],
        "manual_solve_list": []
    },
