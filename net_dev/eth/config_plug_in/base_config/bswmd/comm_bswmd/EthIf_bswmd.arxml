                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:7f1e6bc2-42a7-4226-b0c7-5470606736ab">
                      <SHORT-NAME>EthIfGetCtrlIdxList</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Enables / Disables GetCtrlIdxList API.</L-2>
                        <L-2 L="ZH">概述：EthIfGetCtrlIdxList配置项定义了以太网接口模块（EthIf）可以访问的以太网控制器索引列表，用于映射以太网接口到底层的网络控制器。</L-2>
                        <L-2 L="ZH">注意：在配置EthIfGetCtrlIdxList时，需要确保列表中的控制器索引与实际的以太网控制器硬件资源和底层驱动配置相匹配；索引值应该是唯一的，不应该有重复；在多控制器系统中，正确的控制器索引对于网络通信的正确性至关重要。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
                            <SD GID="VCOS:CfgLock">true</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00070</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SCOPE>LOCAL</SCOPE>
                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                      <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                      <VALUE-CONFIG-CLASSES>
                        <ECUC-VALUE-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
