                      <MAX INTERVAL-TYPE="CLOSED">65.535</MAX>
                      <MIN INTERVAL-TYPE="CLOSED">0.001</MIN>
                    </ECUC-FLOAT-PARAM-DEF>
                  </PARAMETERS>
                  <REFERENCES>
                    <ECUC-REFERENCE-DEF UUID="ECUC:2e5c6c98-a29a-46d1-b7da-e702de0d63a5">
                      <SHORT-NAME>CanNmPnEiraRxNSduRef</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to a Pdu in the COM-Stack.</L-2>
                        <L-2 L="ZH">概述：CanNmPnEiraRxNSduRef是一个配置项，用于表示在CAN网络管理的局部网络功能中，接收全网请求的网络服务数据单元的索引。它是一个指向包含接收到的EIRA请求的网络服务数据单元的索引。</L-2>
                        <L-2 L="ZH">注意：在配置CanNm模块时，必须确保CanNmPnEiraRxNSduRef正确映射到相应的索引；在配置过程中，应避免句柄重复或不一致，以免导致通信问题。</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">Only one SduRef is required for CanNm because the EIRA is the aggregation over all Can Channels.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00072</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
