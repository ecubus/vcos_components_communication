                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:33886411-7139-d20b-e114-9dc303c47eb8">
                                      <SHORT-NAME>PENDING</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
