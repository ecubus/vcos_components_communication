    "COMM012003": {
        "rule_name": "COMM012003",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of ComMPncNmRequest and ComMNmVariant",
        "rule_message": "ComMNmVariant should be 'FULL' or 'PASSIVE' if ComMPncNmRequest is set to true.",
        "rule_ruleset": {
            "ruleset_01":
            {
                "base_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMChannel/ComMNetworkManagement",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMChannel/ComMNetworkManagement/ComMPncNmRequest",
                        "value_operator": "==",
                        "value": true,
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMChannel/ComMNetworkManagement/ComMNmVariant",
                        "value_operator": "==",
                        "value": "FULL",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMChannel/ComMNetworkManagement/ComMNmVariant",
                        "value_operator": "==",
                        "value": "PASSIVE",
                        "logical_operator": "or"
                    }
                ]
            }
        }
    },
    "COMM012005": {
        "rule_name": "COMM012005",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of ComMPncComSignalChannelRef, ComMPncComSignalDirection and ComMPncComSignalKind",
        "rule_message": "ComMPncComSignalChannelRef should not be empty if ComMPncComSignalDirection is not 'RX' or ComMPncComSignalKind is not 'EIRA.",
        "rule_ruleset": {
            "ruleset_01":
            {
                "base_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPnc/ComMPncComSignal",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPnc/ComMPncComSignal/ComMPncComSignalDirection",
                        "value_operator": "!=",
                        "value": "RX",
                        "logical_operator": "or"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPnc/ComMPncComSignal/ComMPncComSignalKind",
                        "value_operator": "!=",
                        "value": "EIRA",
                        "logical_operator": "or"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPnc/ComMPncComSignal/ComMPncComSignalChannelRef",
                        "value_operator": "!=",
                        "value": "",
                        "logical_operator": "and"
                    },
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPnc/ComMPncComSignal/ComMPncComSignalChannelRef",
                        "value_operator": "!=",
                        "value": null,
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "COMM012004": {
        "rule_name": "COMM012004",
        "rule_type": "diff_container_linkage_check",
        "rule_summary": "The linkage check of ComMPncSupport and ComMPncEnabled.",
        "rule_message": "ComMPncSupport should be true, if ComMPncEnabled is true.",
        "rule_ruleset": {
            "ruleset_01": {
                "condition": {
                    "mod_path": ["/AUTOSAR/EcucDefs/ComM/ComMConfigSet/ComMPncEnabled"],
                    "judge_expression": "%0 == True"
                },
                "judgement": {
                    "mod_path": ["/AUTOSAR/EcucDefs/ComM/ComMGeneral/ComMPncSupport"],
                    "judge_expression": "%0 == True"
                },
                "auto_solve_list": [{
                    "solve_info": "Set the value of /AUTOSAR/EcucDefs/ComM/ComMGeneral/ComMPncSupport to true.",
                    "solve_type": "SetValue",
                    "parameter": "/AUTOSAR/EcucDefs/ComM/ComMGeneral/ComMPncSupport",
                    "value": true
                }]
            }
        }
    }
