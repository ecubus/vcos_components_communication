                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:9c06af69-2cee-4cff-958e-722ca8761623">
                      <SHORT-NAME>ComMainFunctionRx</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Contains the configuration parameters of the AUTOSAR COM module's ComMainFunctionRx</L-2>
                        <L-2 L="ZH">概述：ComMainFunctionRx 是 AUTOSAR Communication Stack 中的一个配置参数，用于定义接收通信任务的周期性调用时间。</L-2>
                        <L-2 L="ZH">注意：该配置项的周期设置应考虑系统的实时性要求和网络负载，以避免数据延迟或丢失；周期过短可能会增加系统负载，过长可能影响消息的及时处理；应与其他网络管理和通信服务的周期性调用相协调。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00341</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-FLOAT-PARAM-DEF UUID="ECUC:e546fc3c-05c3-48e4-b0d1-15b4d0f46344">
                          <SHORT-NAME>MainRxTimeBase</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The period between successive calls to ComMainFunctionRx in seconds. This parameter may be used by the COM generator to transform the values of the transmission related timing configuration parameters of the COM module to internal implementation specific counter or tick values. The COM module's internal timing handling is implementation specific.</L-2>
                            <L-2 L="ZH">概述：MainRxTimeBase配置项定义了接收主时间基准，用于确定接收消息的时间精度和处理周期。</L-2>
                            <L-2 L="ZH">注意：该配置项对于确保消息接收和处理的实时性至关重要；必须与系统中的其他时间基准配置保持一致，以避免时间同步问题；在配置时需考虑实际的网络延迟和处理能力，以设置合理的时间基准。</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:Display">
                                <SD GID="VCOS:BaseUnit">s</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
