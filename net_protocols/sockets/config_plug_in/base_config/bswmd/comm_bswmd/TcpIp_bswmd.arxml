                                  <MAX>65535</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2c35d728-e125-43e0-b75c-adeabcb0d8dd">
                                  <SHORT-NAME>TcpIpTlsCiphersuitePriority</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the priority of the cipher. The higher the number the lower the priority.</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                    <L-2 L="ZH">概述：TcpIpTlsCiphersuitePriority 配置项用于定义TLS（传输层安全协议）加密套件在AUTOSAR TCP/IP协议栈中的优先级顺序，确保通信的安全性和性能。</L-2>
                                    <L-2 L="ZH">注意：在配置时需确保所选加密套件与AUTOSAR CP 4.4标准支持的加密套件相匹配；优先级设置应考虑到系统的安全需求和性能影响；不同的加密套件可能需要不同的硬件支持和软件资源。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00243</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>65535</MAX>
                                  <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-STRING-PARAM-DEF UUID="ECUC:c15763c1-1c32-4ebe-8cf1-4ff5c6658594">
                                  <SHORT-NAME>TcpIpTlsCiphersuiteName</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Provides a verbal name for the ciphersuite. The name should be the one defined in the respective RFC, e.g. TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256 (TLS 1.2) or TLS_AES_128_GCM_SHA256 (TLS 1.3)</L-2>
                                    <L-2 L="EN">Tags: atp.Status=draft</L-2>
                                    <L-2 L="ZH">概述：TcpIpTlsCiphersuiteName 配置项用于指定在TCP/IP协议栈中用于TLS（传输层安全协议）连接的加密套件名称，以确保数据传输的安全性。</L-2>
                                    <L-2 L="ZH">注意：在配置TcpIpTlsCiphersuiteName时，需要确保所选的加密套件与AUTOSAR CP 4.4标准支持的套件列表相匹配；考虑到加密套件的安全性和性能影响，选择时应权衡这些因素；还需注意与硬件加速器的兼容性，如果有的话，以确保最佳性能。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_TcpIp_00244</RELATED-TRACE-ITEM-REF>
