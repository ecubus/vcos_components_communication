                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:fbd6f32b-a40f-4cb0-b0aa-ec95515d4924">
                      <SHORT-NAME>CanSMSpinlockRetryCounter</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">The maximal retry counter when trying to get spinlock. When empty the maximal counter is 255</L-2>
                        <L-2 L="ZH">自旋锁尝试最大次数，不配置时默认为255</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanSM_00335</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
