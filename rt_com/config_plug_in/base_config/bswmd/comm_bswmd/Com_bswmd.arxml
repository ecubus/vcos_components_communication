                                      <SHORT-NAME>SINT64</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a5639b48-dc68-de75-fbca-4a4098aae587">
                                      <SHORT-NAME>SINT8</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:6e29f0e1-79b5-dfd3-f902-1cd863b164ed">
                                      <SHORT-NAME>UINT16</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:ce848620-b19c-dddd-e755-da1d117d219b">
                                      <SHORT-NAME>UINT32</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:bf3905e3-e4f0-e55b-d07c-9f1487c4e3f0">
                                      <SHORT-NAME>UINT64</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:39392533-8630-da25-d3b0-0185d1603171">
                                      <SHORT-NAME>UINT8</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b40ccf7d-989d-dbac-dc51-5903611e4d56">
                                      <SHORT-NAME>UINT8_N</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:80714b1d-25ca-98ce-4488-e89e1022769a">
                                  <SHORT-NAME>ComBitPosition</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Starting position within the I-PDU. This parameter refers to the position in the I-PDU and not in the shadow buffer. If the endianness conversion is configured to Opaque the parameter ComBitPosition shall define the bit0 of the first byte like in little endian byte order</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00259</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>4294967295</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:e17b033e-b6c3-90ee-7203-cd4b7de89d71">
                                  <SHORT-NAME>ComBitSize</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Size in bits, for integer signal types. For ComSignalType UINT8_N and UINT8_DYN</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">the size shall be configured by ComSignalLength. For ComSignalTypes FLOAT32 and
                                                                FLOAT64 the size is already defined by the signal type and therefore may be omitted.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00158</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>64</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:12040cb4-a560-97a6-5180-695531bc5419">
                                  <SHORT-NAME>ComSignalLength</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Description:</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">For ComSignalType UINT8_N this parameter specifies the length n in bytes. For ComSignalType UINT8_DYN it specifies the maximum length in bytes. For all other types this parameter shall be ignored.

                                                                The supported maximum length is restricted by the used transportation system. For non TP-PDUs the maximum size of a PDU, and therefore also of any included signal, is limited by the concrete bus characteristic. For example, the limit is 8 bytes for CAN and LIN, 64 bytes for CAN FD and 254 for FlexRay.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00437</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>false</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>4294967295</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-INTEGER-PARAM-DEF UUID="ECUC:2a72d3e4-b8a7-8b65-65f8-4cbac6c9ac39">
                                  <SHORT-NAME>ComUpdateBitPosition</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Bit position of update-bit inside I-PDU.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">If this attribute is omitted then there is no update-bit. This setting must be consistently on sender and on receiver side.

                                                                Range: 0..63 for CAN and LIN,
                                                                0..511 for CAN FD,
                                                                0..2031 for FlexRay,
                                                                0..4294967295 for TP.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00257</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <MULTIPLICITY-CONFIG-CLASSES>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                    <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                                  </MULTIPLICITY-CONFIG-CLASSES>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <MAX>4294967295</MAX>
                                  <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <ECUC-REFERENCE-DEF UUID="ECUC:8942e80b-e492-8b6e-5cb2-59fbaa300845">
                                  <SHORT-NAME>ComGwIPduRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to an I-PDU of a Signal Gateway source or destination description.</L-2>
                                    <L-2 L="ZH">概述：ComGwIPduRef 是一个配置项，用于引用在通信网关中需要路由的IPDU（即数据包单元）。</L-2>
                                    <L-2 L="ZH">注意：在配置通信网关时，必须确保引用的IPDU在系统中是存在且有效的；ComGwIPduRef 应该与相应的源IPDU和目标IPDU配置一致；在AUTOSAR CP 4.4标准中，通信网关的配置应遵循模块间通信原则，确保数据的正确路由和转发。</L-2>
                                    <L-2 L="ZH">该配置项未使用</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00550</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComIPdu</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </CHOICES>
                        </ECUC-CHOICE-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:2369f6e2-91a1-4a41-9a26-ca4deec17900">
                      <SHORT-NAME>ComIPdu</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Contains the configuration parameters of the AUTOSAR COM module's I-PDUs.</L-2>
                        <L-2 L="ZH">概述：ComIPdu是AUTOSAR通信堆栈中的一个配置项，用于定义传输层与网络层之间的接口数据单元（PDU），它封装了网络层的数据。</L-2>
                        <L-2 L="ZH">注意：确保每个ComIPdu的ID在系统中是唯一的；正确配置ComIPdu的大小和属性以匹配网络层的需求；在配置时需考虑数据的发送和接收策略，以保证数据传输的效率和可靠性。</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00340</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLICITY-CONFIG-CLASSES>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>LINK</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                        <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                      </MULTIPLICITY-CONFIG-CLASSES>
                      <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:590e65ba-bcf3-4622-a02c-f9cd1768902b">
                          <SHORT-NAME>ComIPduCancellationSupport</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines for I-PDUs with ComIPduType NORMAL: If the underlying IF-modul supports cancellation of transmit requests.</L-2>
                            <L-2 L="ZH">概述：ComIPduCancellationSupport 配置项用于定义是否支持IPDU（协议数据单元）的取消功能，以便在网络通信中动态管理数据传输。</L-2>
                            <L-2 L="ZH">注意：在AUTOSAR CP 4.4中，确保该功能与底层通信堆栈兼容；此功能可能影响系统的实时性和带宽利用率；在设计时需考虑其对系统性能的潜在影响。</L-2>
                            <L-2 L="ZH">该配置项未使用</L-2>
                          </DESC>
                          <ADMIN-DATA>
                            <SDGS>
                              <SDG GID="VCOS:CfgUnrealized">
                                <SD GID="VCOS:CfgLock">true</SD>
                                <SD GID="VCOS:CfgValue">false</SD>
                              </SDG>
                            </SDGS>
                          </ADMIN-DATA>
                          <INTRODUCTION>
                            <P>
                              <L-1 L="EN">Defines for I-PDUs with ComIPduType TP: If the underlying TP-module supports RX and TX cancellation of ongoing requests.</L-1>
                            </P>
                          </INTRODUCTION>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00709</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>ECU</SCOPE>
                          <MULTIPLICITY-CONFIG-CLASSES>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                            <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
                          </MULTIPLICITY-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>false</DEFAULT-VALUE>
                        </ECUC-BOOLEAN-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:602c5de9-9aae-48e0-90c5-5e40a3ee1562">
                          <SHORT-NAME>ComIPduDirection</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The direction defines if this I-PDU, and therefore the contributing signals and signal groups, shall be sent or received.</L-2>
                            <L-2 L="ZH">概述：ComIPduDirection配置项用于定义通信接口协议数据单元（IPDU）的传输方向，指明是发送方向（发送到网络）还是接收方向（从网络接收）。</L-2>
                            <L-2 L="ZH">注意：在定义ComIPdu时必须明确指定方向，因为这将影响消息处理的逻辑和配置；确保与网络管理和诊断需求相一致；AUTOSAR CP 4.4中此配置项的属性与方向定义一致，无需特别注意版本兼容性问题。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00493</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>LINK</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                            <ECUC-VALUE-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:a2cf083c-2d1a-978e-428e-6fe7b0d37609">
                              <SHORT-NAME>RECEIVE</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f71cd81f-199c-9a20-3bb0-404cc51a11a0">
                              <SHORT-NAME>SEND</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                        </ECUC-ENUMERATION-PARAM-DEF>
                        <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:d23c5427-29e4-4828-9509-d2a6e953bced">
                          <SHORT-NAME>ComIPduSignalProcessing</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">For the definition of the two modes Immediate and Deferred.</L-2>
                            <L-2 L="ZH">概述：ComIPduSignalProcessing配置项定义了IPDU（即消息）中的信号处理模式，它决定了信号更新的时机，例如是否在发送时立即更新或者在接收时延迟更新。</L-2>
                            <L-2 L="ZH">注意：在配置ComIPduSignalProcessing时，需要确保它与系统中的通信需求相匹配；选择错误的信号处理模式可能会导致通信延迟或数据一致性问题；此外，AUTOSAR CP 4.4标准中可能有特定的限制或默认值，需要根据标准文档进行正确配置。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00119</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                          <VALUE-CONFIG-CLASSES>
