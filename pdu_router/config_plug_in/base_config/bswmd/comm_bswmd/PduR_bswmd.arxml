                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:5d20e2d0-f5c2-47fc-9500-52796969d204">
                          <SHORT-NAME>PduRQueueDepth</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This parameter defines the queue depth for this routing path.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_PduR_00356</RELATED-TRACE-ITEM-REF>
