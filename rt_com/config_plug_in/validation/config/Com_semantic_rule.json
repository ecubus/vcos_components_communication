    "COM013004": {
        "rule_name": "COM013004",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The linkage check of ComSignalType and ComSignalEndianness",
        "rule_message": "ComSignalType should be 'UINT8_N' if ComSignalEndianness is set to 'OPAQUE'.",
        "rule_ruleset": {
            "ruleset_01":
            {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal",
                "condition": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal/ComSignalEndianness",
                        "value_operator": "==",
                        "value": "OPAQUE",
                        "logical_operator": "and"
                    }
                ],
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal/ComSignalType",
                        "value_operator": "==",
                        "value": "UINT8_N",
                        "logical_operator": "and"
                    }
                ]
            }
        }
    },
    "COM013003": {
        "rule_name": "COM013003",
        "rule_type": "same_container_linkage_check",
        "rule_summary": "The check of ComIPduType",
        "rule_message": "IPDU ComIPduType is 'Tp' Currently not supported.",
        "rule_ruleset": {
            "ruleset_01":
            {
                "base_path": "/AUTOSAR/EcucDefs/Com/ComConfig",
                "judgement": [
                    {
                        "mod_path": "/AUTOSAR/EcucDefs/Com/ComConfig/ComIPdu/ComIPduType",
                        "value_operator": "!=",
                        "value": "TP",
                        "logical_operator": "and"
                    }
                ]
            }
        }
    }
