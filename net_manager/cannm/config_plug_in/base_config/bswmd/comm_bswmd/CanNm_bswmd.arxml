                    <ECUC-FLOAT-PARAM-DEF UUID="ECUC:cceff8c4-88b2-454b-b189-70cf5941a9c4">
                      <SHORT-NAME>CanNmPnResetTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Specifies the runtime of the reset timer in seconds. This reset time is valid for the reset of PN requests in the EIRA and in the ERA. The value shall be the same for every channel. Thus it is a global config parameter.</L-2>
                        <L-2 L="ZH">概述：CanNmPnResetTime是用于定义在局部网络管理（Partial Networking）场景下，CAN网络管理模块在检测到网络请求后，等待重新激活局部网络功能的时间。</L-2>
                        <L-2 L="ZH">注意：该参数的设置应考虑网络唤醒和休眠策略，以确保不会过早地重置局部网络功能；在配置时应参照具体的车辆网络需求和ECU性能，以确保系统的稳定性和响应性；在AUTOSAR CP 4.4标准中，该参数的单位和取值范围应符合规范要求，否则可能会导致不兼容或功能异常。</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:Display">
                            <SD GID="VCOS:BaseUnit">s</SD>
                          </SDG>
                        </SDGS>
                      </ADMIN-DATA>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_CanNm_00059</RELATED-TRACE-ITEM-REF>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
