                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:6f4a2e6b-5d24-918f-64e6-23afaf9c2337">
                              <SHORT-NAME>ComGwSignal</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container allows specifying a gateway source or destination respectively with a reference to a ComSignal or a ComGroupSignal.</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00551</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <REFERENCES>
                                <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:89dd8bb0-170c-d8ba-21c3-b5c6074dd9e5">
                                  <SHORT-NAME>ComGwSignalRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to an object of a gateway relation. Either to a ComSignal or a ComGroupSignal.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00547</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REFS>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignalGroup/ComGroupSignal</DESTINATION-REF>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal</DESTINATION-REF>
                                  </DESTINATION-REFS>
                                </ECUC-CHOICE-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                          </CHOICES>
                        </ECUC-CHOICE-CONTAINER-DEF>
                        <ECUC-CHOICE-CONTAINER-DEF UUID="ECUC:2803821f-4944-49d4-bcbf-aa360bda4907">
                          <SHORT-NAME>ComGwSource</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This choice container allows the definition of the gateway source signal either by reference to an already configured COM signal / group signal or by a  source description container.</L-2>
                            <L-2 L="ZH">概述：ComGwSource 配置项定义了通信网关的源PDU（协议数据单元），即指定了哪些PDU将被网关模块接收并可能进行路由或转换到其他PDU。</L-2>
                            <L-2 L="ZH">注意：在配置ComGwSource时，需要确保源PDU与目标PDU之间的映射关系正确无误；源PDU标识符必须在系统中是唯一的；在配置过程中应考虑PDU的大小、格式以及转换规则，以确保数据的正确传输和处理。</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00545</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <CHOICES>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:96ce3bc1-58cf-955e-7ad8-2213ed49e3b2">
                              <SHORT-NAME>ComGwSignal</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This container allows specifying a gateway source or destination respectively with a reference to a ComSignal or a ComGroupSignal.</L-2>
                                <L-2 L="ZH">概述：ComGwSignal配置项用于定义网关通信中的信号转发规则，包括源信号和目标信号之间的映射关系，以实现不同网络间的数据交换。</L-2>
                                <L-2 L="ZH">注意：在配置ComGwSignal时，需确保源信号和目标信号的数据类型和大小兼容；对于周期性和事件触发的信号，还需考虑转发策略以满足实时性要求；AUTOSAR CP 4.4标准中，对于网关信号的配置和管理提供了详细的规范，确保遵循这些规范以保证系统的互操作性和稳定性。</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00551</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <REFERENCES>
                                <ECUC-CHOICE-REFERENCE-DEF UUID="ECUC:b1619906-12b7-dc89-37b5-b42a44fb9a60">
                                  <SHORT-NAME>ComGwSignalRef</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to an object of a gateway relation. Either to a ComSignal or a ComGroupSignal.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00547</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <DESTINATION-REFS>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignalGroup/ComGroupSignal</DESTINATION-REF>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal</DESTINATION-REF>
                                  </DESTINATION-REFS>
                                </ECUC-CHOICE-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:d9984304-65a7-4aad-b96b-183daa37336e">
                              <SHORT-NAME>ComGwSourceDescription</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Description of a gateway source. This container allows defining a gateway source without the configuration of a complete COM signal. This allows adding / changing gateway relations post build without the configuration of new signals.</L-2>
                                <L-2 L="ZH">概述：ComGwSourceDescription配置项用于描述通信网关（ComGw）中源PDU（协议数据单元）的属性，包括源PDU的标识符、长度等信息，以便正确处理和转发来自不同源的数据。</L-2>
                                <L-2 L="ZH">注意：在配置ComGwSourceDescription时，必须确保源PDU标识符的唯一性和正确性，以防数据转发错误；源PDU的长度信息需要与实际匹配，以确保数据的完整性；AUTOSAR CP 4.4标准中对通信网关的配置和管理提供了详细的规范，需要遵循这些规范以保证系统的兼容性和稳定性。</L-2>
                                <L-2 L="ZH">该配置项未使用</L-2>
                              </DESC>
                              <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00548</RELATED-TRACE-ITEM-REF>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <PARAMETERS>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:e22f726f-a63d-94e0-50d6-36324fb97f2d">
                                  <SHORT-NAME>ComSignalEndianness</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Defines the endianness of the signal's network representation.</L-2>
                                  </DESC>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00157</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:f0652869-162a-e496-d987-cf2122951610">
                                      <SHORT-NAME>BIG_ENDIAN</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:135c427e-9f79-e0ea-fb1e-419549d794e1">
                                      <SHORT-NAME>LITTLE_ENDIAN</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:8efaee54-92d8-d53b-e638-a52a1e07faaf">
                                      <SHORT-NAME>OPAQUE</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:e06cfb18-5b4d-959b-507b-e5f3dc438131">
                                  <SHORT-NAME>ComSignalType</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">The AUTOSAR type of the signal. Whether or not the signal is signed or unsigned can be found by examining the value of this attribute.</L-2>
                                  </DESC>
                                  <INTRODUCTION>
                                    <P>
                                      <L-1 L="EN">This type could also be used to reserved appropriate storage in AUTOSAR COM.</L-1>
                                    </P>
                                  </INTRODUCTION>
                                  <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Com_00127</RELATED-TRACE-ITEM-REF>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SCOPE>LOCAL</SCOPE>
                                  <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                  <POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
                                  <VALUE-CONFIG-CLASSES>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-LINK-TIME</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>LINK</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                    <ECUC-VALUE-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-VALUE-CONFIGURATION-CLASS>
                                  </VALUE-CONFIG-CLASSES>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:e3ba3a71-a045-e3db-0dfa-f542778e7b32">
                                      <SHORT-NAME>BOOLEAN</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:16827e40-1b5a-e4a9-f910-b17079b1798d">
                                      <SHORT-NAME>FLOAT32</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:401ef01b-a202-d910-e70d-90b217764b00">
                                      <SHORT-NAME>FLOAT64</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:3e885a66-026b-e083-0c18-fc31ad9285a3">
                                      <SHORT-NAME>SINT16</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
